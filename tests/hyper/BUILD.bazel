load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel:rustfmt.bzl", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# The Tableau Hyper API (C++) for the tests and the test data: the Hyper process, a C ABI for the Rust tests and
# :hyper_sql, which the datasets of //tools/datasets use to write Hyper files.

alias(
    name = "hyperapi",
    actual = select({
        "//bazel/platforms:linux_x86_64": "@tableauhyperapi_cxx_linux_x86_64//:hyperapi",
        "//bazel/platforms:macos_arm64": "@tableauhyperapi_cxx_macos_arm64//:hyperapi",
        "//bazel/platforms:macos_x86_64": "@tableauhyperapi_cxx_macos_x86_64//:hyperapi",
    }),
)

alias(
    name = "hyperd",
    actual = select({
        "//bazel/platforms:linux_x86_64": "@tableauhyperapi_cxx_linux_x86_64//:hyperd",
        "//bazel/platforms:macos_arm64": "@tableauhyperapi_cxx_macos_arm64//:hyperd",
        "//bazel/platforms:macos_x86_64": "@tableauhyperapi_cxx_macos_x86_64//:hyperd",
    }),
)

# Executes one SQL statement through the bundled Hyper runtime. Build actions use this
# instead of relying on a separately installed Hyper command-line client.
cc_binary(
    name = "hyper_sql",
    srcs = ["hyper_sql.cc"],
    data = [":hyperd"],
    deps = [":hyperapi"],
)

# A never-throwing C ABI over the Hyper API for the Rust tests
# (//packages/dashql-core:formatter_validation_hyper_test, //packages/dashql-core-runtime:planner_validation_hyper_test).
cc_library(
    name = "hyper_ffi",
    srcs = ["hyper_ffi.cc"],
    hdrs = ["hyper_ffi.h"],
    deps = [":hyperapi"],
)

# The Rust side of the C ABI: a Hyper process, connections and temporary databases of the tests
rust_library(
    name = "hyper_ffi_rs",
    testonly = True,
    srcs = ["hyper_ffi.rs"],
    crate_name = "hyper_ffi",
    edition = "2021",
    deps = [":hyper_ffi"],
)

cc_test(
    name = "smoke_test",
    size = "medium",
    srcs = ["hyper_api_test.cc"],
    data = [":hyperd"],
    env = {"HYPERD_BINARY": "$(rootpath :hyperd)"},
    deps = [
        ":hyperapi",
        "@googletest//:gtest_main",
    ],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test()
