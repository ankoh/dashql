load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//bazel:eslint.bzl", "eslint_test")

# Agent integration tests: real agent harnesses with a fake model, no model calls, see
# docs/design/agent_integration_tests.md. The harnesses come from //bazel:external_agent_harnesses.bzl.
#
#   bazel test //tests/agents:all
#
# On Linux the sandbox of Claude Code needs bubblewrap and socat (apt install bubblewrap socat). The harnesses start
# their own sandboxes, so the tests run outside the sandbox of Bazel.

alias(
    name = "codex",
    actual = select({
        "//bazel/platforms:linux_x86_64": "@codex_linux_x86_64//:vendor/x86_64-unknown-linux-musl/bin/codex",
        "//bazel/platforms:macos_arm64": "@codex_macos_arm64//:vendor/aarch64-apple-darwin/bin/codex",
    }),
)

alias(
    name = "codex_files",
    actual = select({
        "//bazel/platforms:linux_x86_64": "@codex_linux_x86_64//:files",
        "//bazel/platforms:macos_arm64": "@codex_macos_arm64//:files",
    }),
)

alias(
    name = "claude",
    actual = select({
        "//bazel/platforms:linux_x86_64": "@claude_code_linux_x86_64//:claude",
        "//bazel/platforms:macos_arm64": "@claude_code_macos_arm64//:claude",
    }),
    # The stores of hyperdb-edge run Claude Code under the Claude Agent SDK as well
    visibility = ["//packages/hyperdb-edge:__pkg__"],
)

# The agents of the app: the agent host of the main process of the desktop app and the dashql command that it ships,
# see docs/design/agent_integration.md
_DASHQL_APP = [
    "//packages/dashql-cli:dashql",
    "//packages/dashql-native:compile",
    "//packages/dashql-native:package_json",
]

js_test(
    name = "claude_code_sandbox_test",
    size = "medium",
    data = [
        "dashql_app.mjs",
        "fake_anthropic.mjs",
        "probes.mjs",
        ":claude",
    ] + _DASHQL_APP,
    entry_point = "claude_code_sandbox_test.mjs",
    env = {
        "DASHQL_BINARY": "$(rootpath //packages/dashql-cli:dashql)",
        "CLAUDE_BINARY": "$(rootpath :claude)",
    },
    # The binary of the harness stays in its repository, js_test copies only sources of this package
    no_copy_to_bin = [
        ":claude",
    ],
    tags = ["no-sandbox"],
)

js_test(
    name = "codex_sandbox_test",
    size = "medium",
    data = [
        "dashql_app.mjs",
        "fake_openai.mjs",
        "probes.mjs",
        ":codex",
        ":codex_files",
    ] + _DASHQL_APP,
    entry_point = "codex_sandbox_test.mjs",
    env = {
        "DASHQL_BINARY": "$(rootpath //packages/dashql-cli:dashql)",
        "CODEX_BINARY": "$(rootpath :codex)",
    },
    # The binary and the resources of the harness stay in its repository, js_test copies only sources of this package
    no_copy_to_bin = [
        ":codex",
        ":codex_files",
    ],
    tags = ["no-sandbox"],
)

# hyperdb-edge in the harnesses, see docs/wip/hyperdb_edge.md: the compiled command, its describe texts and its skill
_HYPERDB_EDGE = [
    "hyperdb_edge.mjs",
    "probes.mjs",
    "//:node_modules/apache-arrow",
    "//:node_modules/hyperdb-wasm",
    "//packages/hyperdb-edge:compile",
    "//packages/hyperdb-edge:describe_files",
    "//packages/hyperdb-edge:package_json",
    "//packages/hyperdb-edge:skill_files",
]

js_test(
    name = "hyperdb_edge_claude_code_test",
    size = "large",
    data = _HYPERDB_EDGE + [
        "fake_anthropic.mjs",
        ":claude",
    ],
    entry_point = "hyperdb_edge_claude_code_test.mjs",
    env = {
        "CLAUDE_BINARY": "$(rootpath :claude)",
    },
    no_copy_to_bin = [":claude"],
    tags = ["no-sandbox"],
)

js_test(
    name = "hyperdb_edge_codex_test",
    size = "large",
    data = _HYPERDB_EDGE + [
        "fake_openai.mjs",
        ":codex",
        ":codex_files",
    ],
    entry_point = "hyperdb_edge_codex_test.mjs",
    env = {
        "CODEX_BINARY": "$(rootpath :codex)",
    },
    no_copy_to_bin = [
        ":codex",
        ":codex_files",
    ],
    tags = ["no-sandbox"],
)

# The tools of hyperdb-edge in the Tool Runner of the Anthropic SDK, with the fake model. It needs no harness, it is
# tagged like the other tests of the package since the copies of their shared sources must be the same actions.
js_test(
    name = "hyperdb_edge_tool_runner_test",
    size = "large",
    data = _HYPERDB_EDGE + [
        "fake_anthropic.mjs",
        "//:node_modules/@anthropic-ai/sdk",
    ],
    entry_point = "hyperdb_edge_tool_runner_test.mjs",
    tags = ["no-sandbox"],
)

# The tools of hyperdb-edge in the Claude Agent SDK, which runs the pinned Claude Code
js_test(
    name = "hyperdb_edge_agent_sdk_test",
    size = "large",
    data = _HYPERDB_EDGE + [
        "fake_anthropic.mjs",
        ":claude",
        "//:node_modules/@anthropic-ai/claude-agent-sdk",
        "//:node_modules/@modelcontextprotocol/sdk",
        "//:node_modules/zod",
    ],
    entry_point = "hyperdb_edge_agent_sdk_test.mjs",
    env = {
        "CLAUDE_BINARY": "$(rootpath :claude)",
    },
    no_copy_to_bin = [":claude"],
    tags = ["no-sandbox"],
)

# ESLint with the rules of the root eslint.config.mjs, see docs/agents/build_bazel_targets.md
eslint_test()
