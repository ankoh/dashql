load("@aspect_rules_js//js:defs.bzl", "js_test")

# Agent integration tests: real agent harnesses with a fake model, no model calls, see
# docs/wip/agent_integration_tests.md. The harnesses come from //bazel:external_agent_harnesses.bzl.
#
#   bazel test //tests/agents:all
#
# On Linux the sandbox of Claude Code needs bubblewrap and socat (apt install bubblewrap socat). The harnesses start
# their own sandboxes, so the tests run outside the sandbox of Bazel.

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

alias(
    name = "codex",
    actual = select({
        ":linux_x86_64": "@codex_linux_x86_64//:vendor/x86_64-unknown-linux-musl/bin/codex",
        ":macos_arm64": "@codex_macos_arm64//:vendor/aarch64-apple-darwin/bin/codex",
    }),
)

alias(
    name = "codex_files",
    actual = select({
        ":linux_x86_64": "@codex_linux_x86_64//:files",
        ":macos_arm64": "@codex_macos_arm64//:files",
    }),
)

alias(
    name = "claude",
    actual = select({
        ":linux_x86_64": "@claude_code_linux_x86_64//:claude",
        ":macos_arm64": "@claude_code_macos_arm64//:claude",
    }),
)

js_test(
    name = "claude_code_sandbox_test",
    size = "medium",
    data = [
        "fake_anthropic.mjs",
        "probes.mjs",
        "//packages/dashql-cli:dashql",
        ":claude",
    ],
    entry_point = "claude_code_sandbox_test.mjs",
    env = {
        "DASHQL_BINARY": "$(rootpath //packages/dashql-cli:dashql)",
        "CLAUDE_BINARY": "$(rootpath :claude)",
    },
    # The binary of the harness stays in its repository, js_test copies only sources of this package
    no_copy_to_bin = [
        ":claude",
        "//packages/dashql-cli:dashql",
    ],
    tags = ["no-sandbox"],
)

js_test(
    name = "codex_sandbox_test",
    size = "medium",
    data = [
        "fake_openai.mjs",
        "probes.mjs",
        "//packages/dashql-cli:dashql",
        ":codex",
        ":codex_files",
    ],
    entry_point = "codex_sandbox_test.mjs",
    env = {
        "DASHQL_BINARY": "$(rootpath //packages/dashql-cli:dashql)",
        "CODEX_BINARY": "$(rootpath :codex)",
    },
    # The binary and the resources of the harness stay in its repository, js_test copies only sources of this package
    no_copy_to_bin = [
        ":codex",
        ":codex_files",
        "//packages/dashql-cli:dashql",
    ],
    tags = ["no-sandbox"],
)
