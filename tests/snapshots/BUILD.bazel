# The snapshot files of the core tests (YAML, one subpackage per category), and the crate that reads them
# (dashql_snapshots): it loads them as libtest-mimic trials for the core tests, and its snapshot encoders make up
# :snapshotter, which regenerates the snapshot files.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")
load("//tests/snapshots:defs.bzl", "snapshot_update")

package(default_visibility = ["//visibility:public"])

exports_files(["run_snapshotter.sh"])

# Empty filter = update all categories in one run. Run with: bazel run //tests/snapshots:update
snapshot_update(filter = "")

rust_library(
    name = "dashql_snapshots",
    testonly = True,
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "dashql_snapshots",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = [
        "//packages/dashql-core:__pkg__",
        "//packages/dashql-core-runtime:__pkg__",
        "//packages/dashql-core-profile:__pkg__",
    ],
    deps = [
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-core-profile:dashql_core_profile",
        "//packages/dashql-core-runtime:dashql_core_runtime",
        "//packages/dashql-dataflow:dashql_dataflow",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:libtest-mimic",
        "@core_crates//:serde_json",
        "@core_crates//:yaml-rust2",
    ],
)

rust_test(
    name = "dashql_snapshots_unit_tests",
    size = "small",
    crate = ":dashql_snapshots",
)

# Regenerates tests/snapshots/**/*.yaml from the templates *.tpl.yaml.
# bazel run //tests/snapshots/<category>:update, or directly:
#   bazel run //tests/snapshots:snapshotter -- --source_dir=$PWD [--filter=<category>]
rust_binary(
    name = "snapshotter",
    testonly = True,
    srcs = ["src/bin/snapshotter.rs"],
    edition = "2021",
    # Snapshot generation runs the whole pipeline over large scripts (TPC-DS), always optimize
    rustc_flags = ["-Copt-level=3"],
    deps = [
        ":dashql_snapshots",
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-core-profile:dashql_core_profile",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
    ],
)

# The parser snapshots.
rust_test(
    name = "parser_snapshot_test",
    size = "small",
    srcs = ["tests/parser_snapshots.rs"],
    data = ["//tests/snapshots/parser:files"],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_snapshots",
        "//packages/dashql-parser:dashql_parser",
    ],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test()
