{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "timezone": "Europe/Berlin",
    "baseBranchPatterns": ["main"],
    "rangeStrategy": "bump",
    "automergeStrategy": "rebase",
    "postUpdateOptions": ["yarnDedupeFewer", "pnpmDedupe"],
    "prConcurrentLimit": 10,
    "prHourlyLimit": 2,
    "minimumReleaseAge": "3 days",
    "labels": ["dependencies"],
    "npm": {
        "labels": ["dependencies", "javascript"]
    },
    "customDatasources": {
        "tableauhyperapi_cxx": {
            "defaultRegistryUrlTemplate": "https://tableau.github.io/hyper-db/docs/releases",
            "format": "html"
        }
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^bazel/core_dependencies\\.bzl$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n_\\w+_VERSION = \"(?<currentValue>[^\"]+)\""
            ]
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^bazel/external_tableauhyperapi\\.bzl$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nTABLEAUHYPERAPI_VERSION = \"(?<currentValue>[^\"]+)\""
            ]
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^packages/dashql-datasets/datasets\\.bzl$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nTPCH_DUCKDB_VERSION = \"(?<currentValue>[^\"]+)\""
            ]
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^bazel/external_binaryen\\.bzl$/"],
            "matchStrings": ["_BINARYEN_VERSION = \"(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "WebAssembly/binaryen",
            "extractVersionTemplate": "^version_(?<version>.+)$",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^bazel/external_wabt\\.bzl$/"],
            "matchStrings": ["_WABT_VERSION = \"(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "WebAssembly/wabt"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^bazel/external_bison\\.bzl$/"],
            "matchStrings": ["_XPACK_VERSION = \"(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "xpack-dev-tools/bison-xpack",
            "extractVersionTemplate": "^v(?<version>.+)$",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^bazel/external_m4\\.bzl$/"],
            "matchStrings": ["_XPACK_VERSION = \"(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "xpack-dev-tools/m4-xpack",
            "extractVersionTemplate": "^v(?<version>.+)$",
            "versioningTemplate": "loose"
        }
    ],
    "packageRules": [
        {
            "description": "These Bazel extension files pin sha256 hashes next to their versions. Recompute them and refresh MODULE.bazel.lock, which records the repositories the extensions declare.",
            "matchFileNames": [
                "bazel/core_dependencies.bzl",
                "bazel/external_tableauhyperapi.bzl",
                "packages/dashql-datasets/datasets.bzl"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "python3 scripts/update_bazel_hashes.py --force {{{packageFile}}}",
                    "bazel mod deps --lockfile_mode=update"
                ],
                "installTools": { "bazelisk": {} },
                "fileFilters": [
                    "bazel/core_dependencies.bzl",
                    "bazel/external_tableauhyperapi.bzl",
                    "packages/dashql-datasets/datasets.bzl",
                    "MODULE.bazel.lock"
                ],
                "executionMode": "update"
            }
        },
        {
            "description": "The browsers of the browser tests must be the builds that playwright-core lists in its browsers.json.",
            "matchPackageNames": ["playwright-core"],
            "postUpgradeTasks": {
                "commands": [
                    "python3 scripts/update_bazel_hashes.py --force bazel/playwright_chromium.bzl",
                    "python3 scripts/update_bazel_hashes.py --force bazel/playwright_firefox.bzl"
                ],
                "fileFilters": ["bazel/playwright_chromium.bzl", "bazel/playwright_firefox.bzl"],
                "executionMode": "branch"
            }
        },
        {
            "description": "Tableau publishes the Hyper API on PyPI more often than the C++ archives we download. Take the versions from the release notes, which only link the archives that exist. The page has no release dates, so minimumReleaseAge would hold every version back.",
            "matchDatasources": ["custom.tableauhyperapi_cxx"],
            "extractVersion": "/tableauhyperapi-cxx-linux-x86_64-release-main\\.(?<version>\\d+\\.\\d+\\.\\d+)\\.r[0-9a-f]+\\.zip$",
            "minimumReleaseAge": null
        },
        {
            "description": "Rust crates declared with crate.spec in bazel/crates/*.MODULE.bazel. bazel mod deps re-resolves their Cargo.lock files, which have to be committed along with MODULE.bazel.lock.",
            "matchManagers": ["bazel-module"],
            "matchDepTypes": ["crate_spec"],
            "labels": ["dependencies", "rust"],
            "postUpgradeTasks": {
                "commands": ["bash scripts/repin_crates.sh"],
                "installTools": { "bazelisk": {} },
                "fileFilters": ["bazel/crates/*/Cargo.lock", "MODULE.bazel.lock"],
                "executionMode": "branch"
            }
        },
        {
            "description": "wasm-bindgen must match the wasm-bindgen-cli bundled with rules_rust_wasm_bindgen, js-sys and wasm-bindgen-futures follow it. Bump them by hand together with that module.",
            "matchManagers": ["bazel-module"],
            "matchDepTypes": ["crate_spec"],
            "matchPackageNames": ["wasm-bindgen", "wasm-bindgen-futures", "js-sys"],
            "enabled": false
        },
        {
            "description": "rules_rust 0.71 fails on crate_universe calls of non-root modules without a lockfile, and protobuf ships one only from 37 on. Lift this with protobuf 37, and move wasm-bindgen of the core crates to the CLI of rules_rust_wasm_bindgen along with it.",
            "matchManagers": ["bazel-module"],
            "matchPackageNames": ["rules_rust", "rules_rust_wasm_bindgen"],
            "groupName": "rules_rust",
            "allowedVersions": "<0.71.0"
        },
        {
            "description": "TypeScript 7 is the native compiler without the JS compiler API that typescript-eslint (peer typescript <6.1) and typescript-plugin-css-modules build on.",
            "matchManagers": ["npm"],
            "matchPackageNames": ["typescript"],
            "allowedVersions": "<7.0.0"
        },
        {
            "groupName": "tokio",
            "automerge": false,
            "matchPackageNames": ["/^tokio.*/"]
        },
        {
            "groupName": "serde",
            "automerge": false,
            "matchPackageNames": ["serde", "serde_json", "serde_with"]
        },
        {
            "groupName": "primer",
            "automerge": false,
            "matchPackageNames": ["/^@primer/.*/"]
        },
        {
            "description": "napi-derive generates code against the napi release of the same day.",
            "groupName": "napi",
            "automerge": false,
            "matchPackageNames": ["napi", "napi-derive"]
        },
        {
            "description": "vega-lite and vega-embed declare peer dependencies on the vega major.",
            "groupName": "vega",
            "automerge": false,
            "matchPackageNames": ["vega", "vega-embed", "vega-interpreter", "vega-lite"]
        },
        {
            "groupName": "flatbuffers",
            "automerge": false,
            "matchPackageNames": ["flatbuffers", "google/flatbuffers"]
        },
        {
            "groupName": "linter",
            "automerge": false,
            "matchPackageNames": ["/.*eslint.*/"]
        },
        {
            "groupName": "type definitions",
            "automerge": false,
            "matchPackageNames": ["/^@types/.*/", "!/^@types/react.*/"]
        },
        {
            "groupName": "electron",
            "automerge": false,
            "matchPackageNames": ["electron", "electron-builder", "electron-updater"]
        },
        {
            "groupName": "bufbuild",
            "automerge": false,
            "matchPackageNames": ["/^@bufbuild/.*/"]
        },
        {
            "groupName": "arrow_datafusion",
            "automerge": false,
            "matchPackageNames": ["arrow", "/^arrow-.*/", "datafusion", "/^datafusion-.*/"]
        },
        {
            "groupName": "protobuf",
            "automerge": false,
            "matchPackageNames": [
                "prost",
                "prost-build",
                "tonic",
                "tonic-build",
                "tonic-prost",
                "tonic-prost-build"
            ]
        },
        {
            "groupName": "xpack-tools",
            "automerge": false,
            "matchPackageNames": [
                "xpack-dev-tools/bison-xpack",
                "xpack-dev-tools/m4-xpack"
            ]
        },
        {
            "groupName": "vite",
            "automerge": false,
            "matchPackageNames": ["vite", "/^@vitejs\/.*/"]
        },
        {
            "description": "vitest has its own majors, a group with vite titles them \"Update vite to v5\".",
            "groupName": "vitest",
            "automerge": false,
            "matchPackageNames": ["vitest", "/^@vitest\/.*/"]
        }
    ]
}
