# Root package: the shared repository files and the npm link tree of the workspace.
package(default_visibility = ["//visibility:public"])

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm//:defs.bzl", "npm_link_all_packages")

exports_files([
    "LICENSE",
    "NOTICE",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
])

# A local Trino for the app (tpch catalog, CORS proxy on port 8080): bazel run //:trino [-- --port 8080]
# Manual, so `bazel build //...` and CI never fetch Trino.
alias(
    name = "trino",
    testonly = True,
    actual = "//packages/trino-testing:trino_server",
    tags = ["manual"],
)

filegroup(
    name = "example_snippets",
    srcs = glob(["examples/snippets/**/*.sql"], allow_empty = False),
)

# Wrapper so other packages can use the root tsconfig in data.
js_library(
    name = "tsconfig_json",
    srcs = ["tsconfig.json"],
    visibility = ["//visibility:public"],
)

# npm link tree from pnpm lockfile (package.json + pnpm-lock.yaml).
npm_link_all_packages(name = "node_modules")

# DashQL in TypeScript, the bindings of the core module, the runtime and its platforms, shared by //packages/dashql-app
# and the command line tool. The sources with the generated Wasm, see //packages/dashql.
npm_link_package(
    name = "node_modules/@akohn/dashql",
    src = "//packages/dashql:source_package",
)

# The library of the embedded Hyper of hyperdb-wasm, the runtime checks the WebAssembly of Node with it.
npm_link_package(
    name = "node_modules/@akohn/hyperdb-edge",
    src = "//packages/hyperdb-edge:npm_package",
)

# The DashQL runtime in React: the hooks, models and components that //packages/dashql-app and other hosts share,
# and the code, tokens and fonts shared by //packages/dashql-app and //packages/dashql-org.
npm_link_package(
    name = "node_modules/@akohn/dashql-react",
    src = "//packages/dashql-react:npm_package",
)
