{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "noImplicitAny": true,
        "isolatedModules": true,
        "strict": true,
        "jsx": "react-jsx",
        "paths": {
            "@ankoh/dashql-protobuf": [
                "./bazel-bin/packages/dashql/dependencies/dashql-protobuf"
            ],
            "@ankoh/dashql-protobuf/*": [
                "./bazel-bin/packages/dashql/dependencies/dashql-protobuf/*"
            ],
            "@ankoh/dashql-jsonschema": [
                "./bazel-bin/packages/dashql/dependencies/dashql-jsonschema"
            ],
            "@ankoh/dashql-jsonschema/*": [
                "./bazel-bin/packages/dashql/dependencies/dashql-jsonschema/*"
            ],
            "@ankoh/dashql": [
                "./packages/dashql/src/core/index.ts"
            ],
            "@ankoh/dashql/buffers": [
                "./packages/dashql/src/core/buffers.ts"
            ],
            "@ankoh/dashql/browser-worker": [
                "./packages/dashql/src/core/browser_worker.ts"
            ],
            "@ankoh/dashql/runtime": [
                "./packages/dashql/src/runtime/runtime.ts"
            ],
            "@ankoh/dashql/node": [
                "./packages/dashql/src/runtime/node/node_platform.ts"
            ],
            "@ankoh/dashql/runtime/*": [
                "./packages/dashql/src/runtime/*.ts"
            ],
            "@ankoh/dashql/platform/*": [
                "./packages/dashql/src/platform/*.ts"
            ],
            "@ankoh/dashql-wasm/*": [
                "./bazel-bin/packages/dashql/dependencies/dashql-wasm/*"
            ],
            "@ankoh/dashql-flatbuffers/*": [
                "./bazel-bin/packages/dashql/dependencies/dashql-flatbuffers/*"
            ],
            "@ankoh/hyperdb-edge/*": [
                "./packages/hyperdb-edge/src/*.ts"
            ],
            "@ankoh/dashql-ui/*": [
                "./packages/dashql-ui/src/*.ts"
            ],
            "@ankoh/dashql-svg-symbols": [
                "./bazel-bin/packages/dashql-app/dependencies/svg-symbols/symbols.generated.svg"
            ],
            "@dashql/browser-test-act": [
                "./packages/dashql-app/src/tests/react_act.ts"
            ]
        },
        "types": [
            "node",
            "vitest/globals",
            "vite/client"
        ],
        "lib": [
            "es6",
            "es2022",
            "dom"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "typescript-plugin-css-modules"
            }
        ]
    },
    "include": [
        "packages/dashql-app/src/**/*",
        "packages/dashql-app/test/**/*.ts",
        "packages/dashql-app/*.ts",
        "packages/dashql-app/bundles/*.ts",
        "packages/dashql-app/types/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
