# The Data 360 overlay, the namespace `cdp` of a Salesforce connection. See overlay/d360/docs/overview.md.
#
#   api/       the source, edited by hand: overlay.yaml and a file per family with its functions, schemas and prose
#   tests/     a fixture per family: calls, their requests, and responses with where they came from
#   snippets/  workflows for the snippet browser, their steps build on each other
#   docs/      the reference: a document per family generated from api/, and the notes behind it
#
# Bazel generates api/spec.json from the source, which is what the core, the runtime and the app read. After editing the
# source, regenerate the documents and the fixtures with `bazel run //overlay/d360:update`. A fixture response that
# isn't `assumed` is kept.

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

filegroup(
    name = "files",
    srcs = ["api/spec.json"] + glob(["tests/*.json"], allow_empty = True) + glob(["snippets/*/*.sql"]),
    visibility = ["//packages/dashql-app:__pkg__"],
)

rust_binary(
    name = "generate_spec",
    srcs = ["api/generate_spec.rs"],
    edition = "2021",
    deps = [
        "@core_crates//:serde_json",
        "@core_crates//:yaml-rust2",
    ],
)

rust_test(
    name = "generate_spec_test",
    size = "small",
    crate = ":generate_spec",
    edition = "2021",
)

# The facts of the source, as JSON. A build output: the core reads it in the tests below, and the app bundles it.
genrule(
    name = "spec",
    srcs = glob(["api/*.yaml"]),
    outs = ["api/spec.json"],
    cmd = "$(execpath :generate_spec) --api=$$(dirname $(execpath api/overlay.yaml)) --spec=$@",
    tools = [":generate_spec"],
)

rust_binary(
    name = "generate_tests",
    srcs = ["tests/generate_tests.rs"],
    edition = "2021",
    deps = [
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "@core_crates//:serde_json",
    ],
)

sh_binary(
    name = "update",
    srcs = ["update.sh"],
    args = [
        "$(rootpath :generate_spec)",
        "$(rootpath :generate_tests)",
        "$(rootpath api/spec.json)",
    ],
    data = [
        "api/spec.json",
        ":generate_spec",
        ":generate_tests",
    ],
)

# The documents are what the source generates
sh_test(
    name = "docs_up_to_date_test",
    size = "small",
    srcs = ["tests/check_docs.sh"],
    args = ["$(rootpath :generate_spec)"],
    data = [
        ":generate_spec",
        "//overlay/d360/docs:reference",
    ] + glob(["api/*.yaml"]),
)

# The fixtures are what the spec and the examples of the reference generate
sh_test(
    name = "tests_up_to_date_test",
    size = "small",
    srcs = ["tests/check_tests.sh"],
    args = ["$(rootpath :generate_tests)"],
    data = [
        "api/spec.json",
        ":generate_tests",
        "//overlay/d360/docs:reference",
    ] + glob(["tests/*.json"], allow_empty = True),
)

# The core reads the spec: every documented example and snippet passes the checks, and completion offers exactly what
# the reference lists
rust_test(
    name = "spec_test",
    size = "medium",
    srcs = ["tests/spec_test.rs"],
    data = [
        "api/spec.json",
        "//overlay/d360/docs:reference",
    ] + glob(["snippets/*/*.sql"]),
    edition = "2021",
    deps = [
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:serde_json",
    ],
)
