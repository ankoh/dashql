# Package for Bzlmod external_projects extension and build_file fragments.
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@rules_rust//rust:defs.bzl", "rust_lint_config")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files([
    "clippy_test.sh",
    "external_bison.bzl",
    "external_duckdb_cli.BUILD",
    "external_m4.bzl",
    "macos_packaging.bzl",
    "rustfmt_test.sh",
])

# Firefox of Playwright as one folder for the browser tests, which find the executable in it
copy_to_directory(
    name = "playwright_firefox",
    srcs = ["@playwright_firefox//:runtime"],
    include_external_repositories = ["*playwright_firefox"],
    out = "playwright_firefox",
    visibility = ["//visibility:public"],
)

# The safety lints of the Rust crates linked into the core module, see rust_safety.bzl: a panic traps the whole module,
# so no unwrap, expect, panic, unreachable, todo or unimplemented, no index or slice that can fail, no string slice off
# a char boundary and no RefCell borrow held across an await
SAFETY_LINTS = {
    "await_holding_refcell_ref": "deny",
    "expect_used": "deny",
    "indexing_slicing": "deny",
    "panic": "deny",
    "string_slice": "deny",
    "todo": "deny",
    "unimplemented": "deny",
    "unreachable": "deny",
    "unwrap_used": "deny",
}

rust_lint_config(
    name = "rust_safety_lints",
    clippy = SAFETY_LINTS,
    visibility = ["//visibility:public"],
)

# DuckDB CLI executable, selected per exec platform. Used as a build tool
# (exec config) by //tools/datasets for Parquet conversion genrules.
alias(
    name = "duckdb_cli",
    actual = select({
        "@platforms//os:macos": "@duckdb_cli_osx//:duckdb",
        "@platforms//os:linux": "@duckdb_cli_linux_amd64//:duckdb",
    }),
    visibility = ["//visibility:public"],
)

# Formats the Rust files of the repo with the rustfmt.toml of the repo: bazel run //bazel:rustfmt [-- <path>...], see
# "rustfmt" in docs/agents/build_bazel_targets.md
sh_binary(
    name = "rustfmt",
    srcs = ["rustfmt.sh"],
    args = ["$(rootpath @rules_rust//rust/toolchain:current_rustfmt_toolchain)"],
    data = ["@rules_rust//rust/toolchain:current_rustfmt_toolchain"],
)

# ESLint with --fix on the workspace, see eslint.bzl: bazel run //bazel:eslint_fix [-- <paths>]
js_binary(
    name = "eslint_fix",
    data = ["//:eslint_config"],
    entry_point = "eslint_fix.mjs",
)
