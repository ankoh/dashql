package(default_visibility = ["//visibility:public"])

# Neutral exec platform for wasm-opt / wasm-strip actions.
# Both macOS and Linux register this as an exec platform so Bazel selects it
# when an exec_group requires :is_wasm_tool_exec.  Because the platform carries
# no OS/CPU constraints and no exec_properties, the REAPI Command.platform is
# identical on every host → remote cache entries are shared across platforms.
constraint_setting(name = "wasm_tool_exec_setting")

constraint_value(
    name = "is_wasm_tool_exec",
    constraint_setting = ":wasm_tool_exec_setting",
)

platform(
    name = "wasm_tool_exec",
    constraint_values = [":is_wasm_tool_exec"],
)

# The macOS platforms that platform_binary builds the arm64 and x86_64 binaries of the macOS bundle for.
platform(
    name = "aarch64_macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "x86_64_macos",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

# The host platforms that the prebuilt binaries of tools and tests (Hyper, Trino with its Java runtime, the agent
# harnesses) come for, the keys of their selects.
config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)
