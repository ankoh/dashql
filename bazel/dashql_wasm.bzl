def dashql_wasm_linkopts(exports, initial_memory, environment, maximum_memory = None, export_name = "createDashQLModule"):
    linkopts = [
        "-sMODULARIZE=1",
        "-sEXPORT_ES6=1",
        "-sEXPORT_NAME=" + export_name,
        "-sEXPORTED_FUNCTIONS=[" + ",".join(exports) + "]",
        "-sEXPORTED_RUNTIME_METHODS=[" + ",".join(DASHQL_WASM_RUNTIME_METHODS) + "]",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sSTANDALONE_WASM=0",
        "-sINITIAL_MEMORY=" + str(initial_memory),
        "-sAGGRESSIVE_VARIABLE_ELIMINATION=1",
        "-sELIMINATE_DUPLICATE_FUNCTIONS=1",
        "-sFILESYSTEM=0",
        "-sENVIRONMENT='" + environment + "'",
        "-sUSE_WEBGL2=0",
        "-sUSE_SDL=0",
    ]
    if maximum_memory != None:
        linkopts.extend([
            "-sMAXIMUM_MEMORY=" + str(maximum_memory),
            "-sPTHREAD_POOL_SIZE=0",
        ])
    return linkopts
