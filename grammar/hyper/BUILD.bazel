load("//grammar/rust:defs.bzl", "bison_rust_tables")

package(default_visibility = ["//visibility:public"])

bison_rust_tables(
    name = "tables",
    grammar = "sql.y",
    out = "tables.rs",
)

genrule(
    name = "keywords",
    srcs = ["keywords.list"],
    outs = ["keywords.rs"],
    cmd = "python3 $(location keywords.py) $(location keywords.list) $@",
    tools = ["keywords.py"],
)
