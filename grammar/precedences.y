/* Precedence: lowest to highest */
%nonassoc    SET                /* see */
%left        UNION EXCEPT
%left        INTERSECT
%left        OR
%left        AND
%right       NOT
%nonassoc    IS ISNULL NOTNULL    /* IS sets precedence for IS NULL, etc */
%nonassoc    LESS_THAN GREATER_THAN EQUALS LESS_EQUALS GREATER_EQUALS NOT_EQUALS
%nonassoc    BETWEEN IN_P GLOB LIKE ILIKE SIMILAR NOT_LA
%nonassoc    ESCAPE            /* ESCAPE must be just above LIKE/ILIKE/SIMILAR */
%left        POSTFIXOP        /* dummy for postfix Op rules */
%nonassoc    COLON            /* :name parameters, see SLICE_EMPTY_BOUND */
%nonassoc    SLICE_EMPTY_BOUND /* a[:n] is a slice with an empty lower bound, not an index with parameter :n */

/*
 * To support target_el without AS, we must give IDENT an explicit priority
 * between POSTFIXOP and Op.  We can safely assign the same priority to
 * various unreserved keywords as needed to resolve ambiguities (this can't
 * have any bad effects since obviously the keywords will still behave the
 * same as if they weren't keywords).  We need to do this for PARTITION,
 * RANGE, ROWS to support opt_existing_window_name; and for RANGE, ROWS
 * so that they can follow a_expr without creating postfix-operator problems;
 * for GENERATED so that it can follow b_expr;
 * and for NULL so that it can follow b_expr in without creating
 * postfix-operator problems.
 *
 * To support CUBE and ROLLUP in GROUP BY without reserving them, we give them
 * an explicit priority lower than LRB, so that a rule with CUBE LRB will shift
 * rather than reducing a conflicting rule that takes CUBE as a function name.
 * Using the same precedence as IDENT seems right for the reasons given above.
 *
 * The frame_bound productions UNBOUNDED PRECEDING and UNBOUNDED FOLLOWING
 * are even messier: since UNBOUNDED is an unreserved keyword (per spec!),
 * there is no principled way to distinguish these from the productions
 * a_expr PRECEDING/FOLLOWING.  We hack this up by giving UNBOUNDED slightly
 * lower precedence than PRECEDING and FOLLOWING.  At present this doesn't
 * appear to cause UNBOUNDED to be treated differently from other unreserved
 * keywords anywhere else in the grammar, but it's definitely risky.  We can
 * blame any funny behavior of UNBOUNDED on the SQL standard, though.
 */
%nonassoc   UNBOUNDED        /* ideally should have same precedence as IDENT */
%nonassoc   ABORT_P ABSENT ABSOLUTE_P ACCESS ACTION ADD_P ADMIN AFTER AGGREGATE AGGREGATION_THRESHOLD ALL ALSO ALTER ALWAYS ANALYSE ANALYZE ANY ARE ARRAY AS ASC_P ASSERTION ASSIGNMENT ASSUMED ASYMMETRIC ATTACH ATTRIBUTE AUTHORIZATION BACKWARD BEFORE BEGIN_P BIGINT BINARY BIT BOOLEAN_P BOTH BOUNDED BREAK_P BUFFERED BULK BY CACHE CALLED CALL_P CARDINALITY CASCADE CASCADED CASE CAST CATALOG_P CHAIN CHARACTER CHARACTERISTICS CHAR_P CHECKPOINT CHECK_P CLASS CLOSE CLUSTER COALESCE COLLATION COLUMN COMMENT COMMENTS COMMIT COMMITTED CONCURRENTLY CONDITIONAL CONFIGURATION CONFLICT CONNECTION CONST CONSTRAINT CONSTRAINTS CONSTREF CONTENT_P CONTINUE_P CONVERSION_P COPY COST CREATE_P CSV CURRENT_CATALOG CURRENT_DATE CURRENT_P CURRENT_ROLE CURRENT_SCHEMA CURRENT_TIME CURRENT_TIMESTAMP CURRENT_USER CURSOR CYCLE DATABASE DATA_P DAY_P DEALLOCATE DEC DECIMAL_P DECLARE DEFAULT DEFAULTS DEFERRABLE DEFERRED DEFINER DEFRAGMENTATION DELETE_P DELIMITER DELIMITERS DEPENDS DESCRIBE DESCRIPTOR DESC_P DESTINATION DETACH DICTIONARY DIMENSIONS DISABLE_P DISCARD DISTINCT DO DOCUMENT_P DOMAIN_P DOUBLE_P DROP EACH EDGE ELSE EMPTY ENABLE_P ENCODING ENCRYPTED END_P ENUM_P ERROR_P EVENT EXCLUDE EXCLUDING EXCLUSIVE EXECUTE EXISTS EXPLAIN EXPORT_P EXPRESSIONS EXTEND EXTENSION EXTERNAL EXTRACT FACTS FALSE_P FAMILY FETCH FILTER FIRST_P FLOAT_P FOR FORCE FORCEFULLY FOREIGN FORMAT FORWARD FREEZE FROM FUNCTION FUNCTIONS GLOBAL GRACEFULLY GRANT GRANTED GRAPH GRAPH_TABLE GREATEST GROUPING GROUP_P HANDLER HAVING HEADER_P HOLD HOUR_P IDENTITY_P IF_P IGNORE IMMEDIATE IMMUTABLE IMPLICIT_P IMPORT_P INCLUDING INCREMENT INDEX INDEXES INHERIT INHERITS INITIALLY INLINE_P INOUT INPUT_P INSENSITIVE INSERT INSTEAD INTEGER INTERVAL INTO INT_P INVOKER ISOLATION JSON JSON_ARRAY JSON_EXISTS JSON_OBJECT JSON_QUERY JSON_SCALAR JSON_VALUE KEEP KEY KEYS LABEL LAMBDA LANGUAGE LARGE_P LAST_P LATERAL_P LEADING LEAKPROOF LEAST LEVEL LIMIT LISTEN LOAD LOCAL LOCALTIME LOCALTIMESTAMP LOCATION LOCKED LOCK_P LOGGED MAPPING MATCH MATCHED 