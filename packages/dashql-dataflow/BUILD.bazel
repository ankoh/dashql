# The layout of the dataflow canvas: ELK (elk-rs) places the script boxes and routes the edges between them, and
# orthogonal routes go around boxes at any position. Built natively for the snapshots and, with the bindings of
# bindings/lib.rs, into a wasm module of its own (:dataflow_wasm), shipped by @akohn/dashql next to the core module.
# The app loads it when it opens the dataflow canvas, so that the core module does not carry ELK.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")
load("//bazel:wasm_tools.bzl", "optimize_wasm", "wasm_bindgen_module")

rust_library(
    name = "dashql_dataflow",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_dataflow",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "@core_crates//:org-eclipse-elk-alg-layered",
        "@core_crates//:org-eclipse-elk-core",
        "@core_crates//:org-eclipse-elk-graph",
    ],
)

rust_test(
    name = "dashql_dataflow_unit_tests",
    size = "small",
    crate = ":dashql_dataflow",
)

# The wasm-bindgen API of the layout
DATAFLOW_BINDINGS_DEPS = [
    ":dashql_dataflow",
    "@core_crates//:wasm-bindgen",
]

rust_shared_library(
    name = "dashql_dataflow_bindings",
    srcs = ["bindings/lib.rs"],
    crate_name = "dashql_dataflow_bindings",
    crate_root = "bindings/lib.rs",
    edition = "2021",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = DATAFLOW_BINDINGS_DEPS,
)

# The same crate for the host, only for clippy: the bindings compile on the host and fail only when they call JS
rust_library(
    name = "dashql_dataflow_bindings_lint",
    srcs = ["bindings/lib.rs"],
    crate_name = "dashql_dataflow_bindings",
    crate_root = "bindings/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    tags = ["manual"],
    deps = DATAFLOW_BINDINGS_DEPS,
)

# Clippy with the safety lints, see //bazel:rust_safety.bzl
rust_safety_test(
    name = "clippy_test",
    deps = [
        ":dashql_dataflow",
        ":dashql_dataflow_bindings_lint",
    ],
)

# The wasm_file attribute transitions to wasm32, independent of the host --platforms.
rust_wasm_bindgen(
    name = "dashql_dataflow_bindgen",
    out_name = "dashql_dataflow",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":dashql_dataflow_bindings",
)

wasm_bindgen_module(
    name = "dashql_dataflow_bindgen_wasm",
    bindgen = ":dashql_dataflow_bindgen",
)

# Release: wasm-opt -O3 + strip; dev: copy through unchanged.
optimize_wasm(
    name = "dataflow_wasm",
    src = ":dashql_dataflow_bindgen_wasm",
    out = "dashql_dataflow_bg.wasm",
    visibility = ["//visibility:public"],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test(
    name = "rustfmt_test",
    srcs = glob(["**/*.rs"]),
)
