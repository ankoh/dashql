{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "isolatedModules": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "types": ["node", "vitest/globals"],
        "lib": ["ES2022", "DOM"]
    },
    "include": ["src/**/*.ts"]
}
