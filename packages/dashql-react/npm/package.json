{
  "name": "@akohn/dashql-react",
  "version": "0.0.0",
  "description": "DashQL in React: the hooks of the runtime of @akohn/dashql, the models that components show, the components, and the design tokens, fonts and icons of DashQL",
  "type": "module",
  "license": "MPL-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankoh/dashql.git",
    "directory": "packages/dashql-react"
  },
  "homepage": "https://github.com/ankoh/dashql/tree/main/packages/dashql-react#readme",
  "bugs": { "url": "https://github.com/ankoh/dashql/issues" },
  "sideEffects": ["*.css"],
  "exports": {
    "./style.css": "./dist/style.css",
    "./symbols.svg": "./dist/symbols.svg",
    "./fonts/*.css": "./fonts/*.css",
    "./styles/*.css": "./styles/*.css",
    "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js" }
  },
  "files": ["dist", "fonts", "styles", "README.md", "LICENSE", "NOTICE"],
  "dependencies": {
    "@primer/behaviors": "^1.11.0",
    "d3": "^7.9.2",
    "react-window": "^2.5.3"
  },
  "peerDependencies": {
    "@akohn/dashql": "0.0.0",
    "apache-arrow": "^21.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0"
  },
  "peerDependenciesMeta": {
    "vega": { "optional": true },
    "vega-embed": { "optional": true },
    "vega-interpreter": { "optional": true },
    "vega-lite": { "optional": true }
  }
}
