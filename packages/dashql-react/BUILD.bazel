load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")

# DashQL in React (docs/design/dashql_runtime.md): the hooks of the views, actions and commands of a runtime, the models
# that components show, and the design tokens, fonts and brand code (styles/, fonts/, src/brand, src/theme) shared by the
# app (//packages/dashql-app), the website (//packages/dashql-org) and other hosts of the runtime. A source package,
# nothing is compiled: consumers bundle the TypeScript and the stylesheets themselves. Linked as
# //:node_modules/@akohn/dashql-react, the dev servers read packages/dashql-react directly.

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/**/*.css", "src/**/*.json", "src/**/*.ts", "src/**/*.tsx"])

copy_to_bin(
    name = "typecheck_inputs",
    srcs = _SOURCES + ["package.json", "tsconfig.bazel.json"],
)

# Against the sources of @akohn/dashql and the DOM, the package runs in browsers
typescript_bin.tsc_test(
    name = "tsc_typecheck_test",
    size = "small",
    args = ["--project", "tsconfig.bazel.json"],
    chdir = package_name(),
    data = [
        ":typecheck_inputs",
        "//:node_modules/@akohn/dashql",
        "//:node_modules/@primer/behaviors",
        "//:node_modules/@react-hook/resize-observer",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/apache-arrow",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
        "//packages/dashql:dep_jsonschema",
        "//packages/dashql:dep_protobuf",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@zip.js/zip.js",
        "//:node_modules/@akohn/hyperdb-edge",
        "//:node_modules/flatbuffers",
        "//:node_modules/hyperdb-wasm",
        "//:node_modules/immutable",
        "//:node_modules/vega-lite",
    ],
)

# The package reaches React, apache-arrow, @akohn/dashql and the libraries of the components only, nothing of an app; the
# components reach neither the hooks nor the runtime
js_test(
    name = "boundary_test",
    data = _SOURCES,
    entry_point = "test/boundary_test.mjs",
)

npm_package(
    name = "npm_package",
    package = "@akohn/dashql-react",
    srcs = ["package.json"] + _SOURCES + glob([
        "fonts/*.css",
        "fonts/*.ttf",
        "fonts/*.txt",
        "styles/*.css",
        "styles/flavors/*.css",
    ]),
    include_transitive_sources = False,
    include_transitive_types = False,
)
