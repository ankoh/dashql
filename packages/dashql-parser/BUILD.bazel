# The SQL grammar of DashQL: the LALR(1) tables and actions of //grammar emitted through
# //grammar/rust:tables.rs.m4, the keywords, the scanner, the parse context and the LR driver.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")

# rules_rust places generated sources next to the checked-in ones only if they belong to the same
# package, copy the generated modules of //grammar into the crate.
genrule(
    name = "dashql_parser_tables_rs",
    srcs = ["//grammar:gen/rust/parser_tables.rs"],
    outs = ["src/tables.rs"],
    cmd = "cp $< $@",
)

genrule(
    name = "dashql_parser_keywords_rs",
    srcs = ["//grammar:keywords_rs"],
    outs = ["src/keywords/table.rs"],
    cmd = "cp $< $@",
)

rust_library(
    name = "dashql_parser",
    srcs = glob(["src/**/*.rs"]) + [
        ":dashql_parser_keywords_rs",
        ":dashql_parser_tables_rs",
    ],
    crate_name = "dashql_parser",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:logos",
    ],
)

# The Hyper cases of the grammar tests, the formatter round trip of the core formats them too
exports_files(
    ["src/parser/hyper_cases.rs"],
    visibility = ["//packages/dashql-core:__pkg__"],
)

rust_test(
    name = "dashql_parser_unit_tests",
    size = "small",
    crate = ":dashql_parser",
)

# Clippy with the safety lints, see //bazel:rust_safety.bzl
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql_parser"],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test(
    name = "rustfmt_test",
    srcs = glob(["**/*.rs"]),
)
