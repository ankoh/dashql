# The DashQL core, the language: scripts, catalog, analyzer, cursor, completion, formatter and script diffs, and the
# scripts on top of it: editor sessions, compilation, batch processing, the catalog changes of executed statements and
# the renderer specs of `@vis` tags. The planner and the state of a workbook are //packages/dashql-core-runtime, the
# shell is //packages/dashql-core-shell, the query profile //packages/dashql-core-profile, the wasm module is
# //packages/dashql-core-bindings.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")

rust_library(
    name = "dashql_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_core",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:pulldown-cmark",
        "@core_crates//:ropey",
        "@core_crates//:serde",
        "@core_crates//:serde_json",
    ],
)

rust_test(
    name = "dashql_core_unit_tests",
    size = "small",
    crate = ":dashql_core",
)

# Clippy with the safety lints, see //bazel:rust_safety.bzl
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql_core"],
)

# Snapshot tests of the core: one target per category, each a libtest-mimic binary.
DASHQL_CORE_SNAPSHOT_TESTS = {
    "formatter_snapshot_test": ("formatter_snapshots.rs", "//tests/snapshots/formatter:files"),
    "analyzer_snapshot_test": ("analyzer_snapshots.rs", "//tests/snapshots/analyzer:files"),
    "completion_snapshot_test": ("completion_snapshots.rs", "//tests/snapshots/completion:files"),
    "diff_snapshot_test": ("diff_snapshots.rs", "//tests/snapshots/diff:files"),
    "visualize_snapshot_test": ("visualize_snapshots.rs", "//tests/snapshots/visualize:files"),
}

[rust_test(
    name = name,
    size = "small",
    srcs = ["tests/" + src],
    data = [data],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//tests/snapshots:dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde_json",
    ],
) for name, (src, data) in DASHQL_CORE_SNAPSHOT_TESTS.items()]

# Executes the formatted SQL of the formatter snapshots with a hyper validation in Hyper, through the C ABI
# //tests/hyper:hyper_ffi over the Hyper C++ API.
rust_test(
    name = "formatter_validation_hyper_test",
    size = "medium",
    srcs = ["tests/formatter_validation_hyper.rs"],
    data = [
        "//tests/hyper:hyperd",
        "//tests/snapshots/formatter:files",
    ],
    edition = "2021",
    env = {"HYPERD_BINARY": "$(rootpath //tests/hyper:hyperd)"},
    target_compatible_with = select({
        "//bazel/platforms:linux_x86_64": [],
        "//bazel/platforms:macos_arm64": [],
        "//bazel/platforms:macos_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    use_libtest_harness = False,
    deps = [
        ":dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//tests/snapshots:dashql_snapshots",
        "//tests/hyper:hyper_ffi_rs",
    ],
)

# Formats every script of the parser snapshots without syntax errors and the Hyper cases of the parser: the formatter
# must be able to represent every node and its output must parse again.
rust_test(
    name = "formatter_roundtrip_test",
    size = "small",
    srcs = ["tests/formatter_roundtrip.rs"],
    # The test reads the Hyper cases of the parser as a module of its own
    compile_data = ["//packages/dashql-parser:src/parser/hyper_cases.rs"],
    data = ["//tests/snapshots/parser:files"],
    edition = "2021",
    deps = [
        ":dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//tests/snapshots:dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
    ],
)

# The tests of the core in one libtest binary, a module per file of tests/ (tests/main.rs), so that a change of the
# core links one test binary instead of one per file. Run the tests of a file with --test_arg=<file>::
rust_test(
    name = "tests",
    size = "small",
    srcs = glob(["tests/*_test.rs"]) + [
        "tests/buffers_enums.rs",
        "tests/main.rs",
    ],
    crate_root = "tests/main.rs",
    edition = "2021",
    deps = [
        ":dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde_json",
    ],
)

# ---------------------------------------------------------------------------
# Benchmarks (bazel run -c opt //packages/dashql-core:bench_pipeline)
# ---------------------------------------------------------------------------

rust_binary(
    name = "bench_pipeline",
    srcs = [
        "benches/harness.rs",
        "benches/pipeline.rs",
    ],
    crate_root = "benches/pipeline.rs",
    edition = "2021",
    deps = [
        ":dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
    ],
)

# Scan, parse and analyze over CTE chains of 1 to 1000 TPC-H queries:
# bazel run -c opt //packages/dashql-core:bench_pipeline_ctes [-- <filter>]
rust_binary(
    name = "bench_pipeline_ctes",
    srcs = [
        "benches/harness.rs",
        "benches/pipeline_ctes.rs",
    ],
    crate_root = "benches/pipeline_ctes.rs",
    edition = "2021",
    deps = [":dashql_core"],
)

# Editor events of a session (bazel run -c opt //packages/dashql-core:bench_session)
rust_binary(
    name = "bench_session",
    srcs = [
        "benches/harness.rs",
        "benches/session.rs",
    ],
    crate_root = "benches/session.rs",
    edition = "2021",
    deps = [
        ":dashql_core",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
    ],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test()
