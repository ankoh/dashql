# The query profile: parses engine plans, lays them out as a tree for the profile renderer of the app and rolls
# up execution progress. Independent of the SQL core, it shares only the FlatBuffers bindings.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "dashql_core_profile",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_core_profile",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde",
        "@core_crates//:serde_json",
    ],
)

rust_test(
    name = "dashql_core_profile_unit_tests",
    size = "small",
    crate = ":dashql_core_profile",
)

# The query profile snapshots (snapshots/profiles/hyper/tests/*.yaml, snapshots/profiles/progress/*.yaml)
rust_test(
    name = "query_profile_snapshot_test",
    size = "small",
    srcs = ["tests/query_profile_snapshots.rs"],
    data = [
        "//snapshots/profiles/hyper/tests:files",
        "//snapshots/profiles/progress:files",
        "//snapshots/profiles/trino/recordings:files",
        "//snapshots/profiles/trino/plans:files",
        "//snapshots/profiles/trino/progress:files",
    ],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core_profile",
        "//packages/dashql-snapshots:dashql_snapshots",
    ],
)
