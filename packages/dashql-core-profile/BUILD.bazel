# The query profile: parses engine plans, lays them out as a tree for the profile renderer of the app and rolls
# up execution progress. Independent of the SQL core, it shares only the FlatBuffers bindings.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:rust_safety.bzl", "rust_safety_test")

rust_library(
    name = "dashql_core_profile",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_core_profile",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde",
        "@core_crates//:serde_json",
    ],
)

rust_test(
    name = "dashql_core_profile_unit_tests",
    size = "small",
    crate = ":dashql_core_profile",
)

# Clippy with the safety lints, see //bazel:rust_safety.bzl
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql_core_profile"],
)

# The query profile snapshots (tests/snapshots/profiles/hyper/tests/*.yaml, tests/snapshots/profiles/progress/*.yaml)
rust_test(
    name = "query_profile_snapshot_test",
    size = "small",
    srcs = ["tests/query_profile_snapshots.rs"],
    data = [
        "//tests/snapshots/profiles/hyper/tests:files",
        "//tests/snapshots/profiles/progress:files",
        "//tests/snapshots/profiles/trino/recordings:files",
        "//tests/snapshots/profiles/trino/plans:files",
        "//tests/snapshots/profiles/trino/progress:files",
    ],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core_profile",
        "//tests/snapshots:dashql_snapshots",
    ],
)
