load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_bazel_lib//lib:tar.bzl", "mtree_mutate", "mtree_spec", "tar")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# dashql, the command line tool of DashQL on @ankoh/dashql, see README.md:
#
# bazel run //packages/dashql-cli:dashql -- lint <file.sql|dir|->...
# bazel run //packages/dashql-cli:dashql -- format [--write|--check] <file.sql|dir|->...
# bazel run //packages/dashql-cli:dashql -- run <workbook-dir> [<script>...]

package(default_visibility = ["//visibility:private"])

_SOURCES = glob(["src/**/*.ts"])

_MODULES = glob(
    ["src/**/*.ts"],
    exclude = ["src/**/*.test.ts"],
)

# The generated packages that @ankoh/dashql imports, resolved through the aliases of vite.config.mjs and vitest.config.mjs
# and the paths of tsconfig.bazel.json like in //packages/dashql. Those of the core module come with its source package.
copy_to_directory(
    name = "dep_protobuf",
    srcs = ["//proto/pb:ts_gen"],
    out = "./dependencies/dashql-protobuf",
    replace_prefixes = {
        "proto/pb/ts_gen": "",
    },
)

copy_to_directory(
    name = "dep_jsonschema",
    srcs = ["//proto/json:ts_gen"],
    out = "./dependencies/dashql-jsonschema",
    replace_prefixes = {
        "proto/json": "",
    },
)

# @ankoh/dashql is a source package, its imports come from here. `run` reaches all of it, `lint` and `format` only the
# bindings and the SQL support of the platform.
_DEPENDENCIES = [
    ":dep_jsonschema",
    ":dep_protobuf",
    "//:node_modules/@ankoh/dashql",
    "//:node_modules/@ankoh/hyperdb-edge",
    "//:node_modules/@bufbuild/protobuf",
    "//:node_modules/apache-arrow",
    "//:node_modules/flatbuffers",
    "//:node_modules/hyperdb-wasm",
    "//:node_modules/immutable",
    "//:node_modules/vega-lite",
]

# The command as one module for Node, the Wasm of the core stays a file of the package @ankoh/dashql
vite_bin.vite(
    name = "bundle",
    srcs = _MODULES + [
        "package.json",
        "vite.config.mjs",
        "//:node_modules/vite",
    ] + _DEPENDENCIES,
    args = ["build", "--config", "vite.config.mjs"],
    chdir = "packages/dashql-cli",
    outs = ["dist/dashql.js"],
    # The agent tests run it with Node like an installation, see //tests/agents
    visibility = ["//tests/agents:__pkg__"],
)

js_binary(
    name = "dashql",
    data = [
        "package.json",
        ":bundle",
        # The Wasm of the core, @ankoh/dashql/wasm
        "//:node_modules/@ankoh/dashql",
        # The embedded Hyper of `run`, loaded only there with its Wasm file
        "//:node_modules/hyperdb-wasm",
    ],
    entry_point = "dist/dashql.js",
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "typecheck_inputs",
    srcs = _SOURCES + [
        "package.json",
        "tsconfig.bazel.json",
    ],
)

typescript_bin.tsc_test(
    name = "tsc_typecheck_test",
    size = "small",
    args = ["--project", "tsconfig.bazel.json"],
    chdir = "packages/dashql-cli",
    data = [
        ":typecheck_inputs",
        "//:node_modules/@types/node",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES,
)

# The commands with the process of a test: arguments, files, stdin, the output and the exit codes. dashql run starts the
# embedded Hyper in many tests, about 35 seconds on a workstation, more on a runner of CI
vitest_bin.vitest_test(
    name = "test",
    size = "medium",
    args = [
        "run",
        "--config",
        "vitest.config.mjs",
    ],
    chdir = "packages/dashql-cli",
    data = _SOURCES + [
        "package.json",
        "vitest.config.mjs",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES,
)

# dashql as the user calls it: the bundle, its exit codes, stdin and the invoking directory
js_test(
    name = "binary_test",
    size = "small",
    data = [":dashql"],
    entry_point = "test/binary_test.mjs",
    env = {"DASHQL_BINARY": "$(rootpath :dashql)"},
)

# The package on npm: the bundle with the metadata of npm/package.json, `npx -y @ankoh/dashql-cli connect ...` runs it.
# @ankoh/dashql and hyperdb-wasm stay dependencies, the bundle reads their Wasm files from their packages.
genrule(
    name = "npm_files",
    srcs = [
        ":bundle",
        "npm/package.json",
        "README.md",
        "//:LICENSE",
        "//:NOTICE",
    ],
    outs = [
        "npm_package_files/dist/dashql.js",
        "npm_package_files/package.json",
        "npm_package_files/README.md",
        "npm_package_files/LICENSE",
        "npm_package_files/NOTICE",
    ],
    cmd = " && ".join([
        "cp $(location :bundle) $(RULEDIR)/npm_package_files/dist/dashql.js",
        "cp $(location npm/package.json) $(RULEDIR)/npm_package_files/package.json",
        "cp $(location README.md) $(RULEDIR)/npm_package_files/README.md",
        "cp $(location //:LICENSE) $(RULEDIR)/npm_package_files/LICENSE",
        "cp $(location //:NOTICE) $(RULEDIR)/npm_package_files/NOTICE",
    ]),
)

npm_package(
    name = "npm_package",
    package = "@ankoh/dashql-cli",
    srcs = [":npm_files"],
    include_transitive_sources = False,
    include_transitive_types = False,
    replace_prefixes = {"npm_package_files/": ""},
)

mtree_spec(
    name = "npm_tarball_mtree",
    srcs = [":npm_package"],
)

mtree_mutate(
    name = "npm_mtree",
    mtree = ":npm_tarball_mtree",
    strip_prefix = "packages/dashql-cli/npm_package",
    package_dir = "package",
)

tar(
    name = "npm_tarball",
    srcs = [":npm_package"],
    mtree = ":npm_mtree",
    out = "dashql-cli.tgz",
    compress = "gzip",
    args = ["--format=ustar", "--uid=0", "--gid=0", "--uname=root", "--gname=root"],
)

# The package on npm depends on the versions that the bundle was built with. A js_test takes the files of its own
# package, the manifests of the root and of @ankoh/dashql on npm are copied here.
genrule(
    name = "npm_package_test_manifests",
    srcs = [
        "//:package.json",
        "//packages/dashql:npm/package.json",
    ],
    outs = [
        "npm_manifests/root_package.json",
        "npm_manifests/dashql_package.json",
    ],
    cmd = " && ".join([
        "cp $(location //:package.json) $(RULEDIR)/npm_manifests/root_package.json",
        "cp $(location //packages/dashql:npm/package.json) $(RULEDIR)/npm_manifests/dashql_package.json",
    ]),
)

js_test(
    name = "npm_package_test",
    size = "small",
    data = [
        ":bundle",
        "npm/package.json",
        "npm_manifests/dashql_package.json",
        "npm_manifests/root_package.json",
    ],
    entry_point = "test/npm_package_test.mjs",
    env = {
        "NPM_PACKAGE_JSON": "$(rootpath npm/package.json)",
        "DASHQL_PACKAGE_JSON": "$(rootpath npm_manifests/dashql_package.json)",
        "ROOT_PACKAGE_JSON": "$(rootpath npm_manifests/root_package.json)",
        "DASHQL_BUNDLE": "$(rootpath :bundle)",
    },
)

# The snippets of the app are what dashql format prints, in the dialect of their engine
sh_test(
    name = "example_snippets_formatted_test",
    size = "small",
    srcs = ["test/check_example_snippets.sh"],
    args = ["$(rootpath :dashql)"],
    data = [
        ":dashql",
        "//:example_snippets",
    ],
)
