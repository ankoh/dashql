load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel:macos_packaging.bzl", "platform_binary")

package(default_visibility = ["//visibility:private"])

# bazel run //packages/dashql-cli:dashql -- lint <file.sql|dir|->...
# bazel run //packages/dashql-cli:dashql -- agent serve
# bazel run //packages/dashql-cli:dashql -- agent status
rust_binary(
    name = "dashql",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_cli",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-core-session:dashql_core_session",
        "@core_crates//:base64",
        "@core_crates//:futures-util",
        "@core_crates//:getrandom",
        "@core_crates//:httparse",
        "@core_crates//:libc",
        "@core_crates//:serde_json",
        "@core_crates//:tokio",
        "@core_crates//:tokio-tungstenite",
    ],
)

# The binary in each architecture's DashQL.app, Contents/Resources/bin/dashql
platform_binary(
    name = "dashql_aarch64",
    binary = ":dashql",
    platform = "//bazel/platforms:aarch64_macos",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//packages/dashql-native:__pkg__"],
)

platform_binary(
    name = "dashql_x86_64",
    binary = ":dashql",
    platform = "//bazel/platforms:x86_64_macos",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//packages/dashql-native:__pkg__"],
)

rust_test(
    name = "tests",
    size = "small",
    # The tests check the messages of the agent server against the schema, and the skill against the commands
    compile_data = [
        "skill/dashql/SKILL.md",
        "//proto/json:dashql/agent_bridge.json",
    ],
    crate = ":dashql",
)

BRIDGE_TEST_DEPS = [
    "@core_crates//:futures-util",
    "@core_crates//:serde_json",
    "@core_crates//:tokio",
    "@core_crates//:tokio-tungstenite",
]

# The agent bridge end to end: the dashql binary as server, command line tool and `dashql` of harness runs,
# a DashQL page on the WebSocket and a scripted harness
rust_test(
    name = "bridge_test",
    size = "small",
    srcs = [
        "src/agent/schema.rs",
        "tests/bridge/bridge_test.rs",
        "tests/bridge/support.rs",
    ],
    compile_data = ["//proto/json:dashql/agent_bridge.json"],
    crate_root = "tests/bridge/bridge_test.rs",
    data = [
        "tests/bridge/fake_harness.sh",
        ":dashql",
    ],
    edition = "2021",
    env = {
        "DASHQL_BINARY": "$(rootpath :dashql)",
        "FAKE_HARNESS": "$(rootpath tests/bridge/fake_harness.sh)",
    },
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = BRIDGE_TEST_DEPS,
)

# The agent bridge with the installed claude and opencode, their logins and models. Manual: it costs model calls.
# bazel test //packages/dashql-cli:bridge_harness_test [--test_env=DASHQL_TEST_HARNESSES=opencode]
rust_test(
    name = "bridge_harness_test",
    size = "large",
    srcs = [
        "src/agent/schema.rs",
        "tests/bridge/bridge_harness_test.rs",
        "tests/bridge/support.rs",
    ],
    compile_data = ["//proto/json:dashql/agent_bridge.json"],
    crate_root = "tests/bridge/bridge_harness_test.rs",
    data = [":dashql"],
    edition = "2021",
    env = {"DASHQL_BINARY": "$(rootpath :dashql)"},
    env_inherit = [
        "HOME",
        "PATH",
        "SHELL",
        "USER",
        "LOGNAME",
        "TMPDIR",
    ],
    tags = [
        "external",
        "local",
        "manual",
        "no-cache",
    ],
    deps = BRIDGE_TEST_DEPS,
)

# The skill that teaches agents the dashql agent commands
filegroup(
    name = "skill",
    srcs = glob(["skill/**"]),
    visibility = ["//visibility:public"],
)
