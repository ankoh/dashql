load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# dashql, the command line tool of DashQL on @ankoh/dashql-runtime, see README.md:
#
# bazel run //packages/dashql-cli:dashql -- lint <file.sql|dir|->...
# bazel run //packages/dashql-cli:dashql -- format [--write|--check] <file.sql|dir|->...

package(default_visibility = ["//visibility:private"])

_SOURCES = glob(["src/**/*.ts"])

_MODULES = glob(
    ["src/**/*.ts"],
    exclude = ["src/**/*.test.ts"],
)

_DEPENDENCIES = [
    "//:node_modules/@ankoh/dashql-core",
    "//:node_modules/@ankoh/dashql-runtime",
]

# The command as one module for Node, the core stays a package next to it
vite_bin.vite(
    name = "bundle",
    srcs = _MODULES + [
        "package.json",
        "vite.config.mjs",
        "//:node_modules/vite",
    ] + _DEPENDENCIES,
    args = ["build", "--config", "vite.config.mjs"],
    chdir = "packages/dashql-cli",
    outs = ["dist/dashql.js"],
    # The agent tests run it with Node like an installation, see //tests/agents
    visibility = ["//tests/agents:__pkg__"],
)

js_binary(
    name = "dashql",
    data = [
        "package.json",
        ":bundle",
        "//:node_modules/@ankoh/dashql-core",
        # The core imports it without declaring it
        "//:node_modules/flatbuffers",
    ],
    entry_point = "dist/dashql.js",
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "typecheck_inputs",
    srcs = _SOURCES + [
        "package.json",
        "tsconfig.bazel.json",
    ],
)

typescript_bin.tsc_test(
    name = "tsc_typecheck_test",
    size = "small",
    args = ["--project", "tsconfig.bazel.json"],
    chdir = "packages/dashql-cli",
    data = [
        ":typecheck_inputs",
        "//:node_modules/@types/node",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES,
)

# The commands with the process of a test: arguments, files, stdin, the output and the exit codes
vitest_bin.vitest_test(
    name = "test",
    size = "small",
    args = [
        "run",
        "--config",
        "vitest.config.mjs",
    ],
    chdir = "packages/dashql-cli",
    data = _SOURCES + [
        "package.json",
        "vitest.config.mjs",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES,
)

# dashql as the user calls it: the bundle, its exit codes, stdin and the invoking directory
js_test(
    name = "binary_test",
    size = "small",
    data = [":dashql"],
    entry_point = "test/binary_test.mjs",
    env = {"DASHQL_BINARY": "$(rootpath :dashql)"},
)

# The snippets of the app are what dashql format prints, in the dialect of their engine
sh_test(
    name = "example_snippets_formatted_test",
    size = "small",
    srcs = ["test/check_example_snippets.sh"],
    args = ["$(rootpath :dashql)"],
    data = [
        ":dashql",
        "//:example_snippets",
    ],
)
