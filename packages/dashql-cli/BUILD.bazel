# `dashql`, the commands of an agent that the desktop app runs for a question. Every command but `guide` and `help` is a
# call of the page of the workbook through the server of the app, see docs/design/agent_integration.md. The binary
# ships only inside DashQL.app (Contents/Resources/bin/dashql); a session file of the app names the server:
#
# bazel run //packages/dashql-cli:dashql -- guide
# bazel run //packages/dashql-cli:dashql -- --session <folder>/session.json scripts

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel:macos_packaging.bzl", "platform_binary")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")

package(default_visibility = ["//visibility:private"])

rust_binary(
    name = "dashql",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_cli",
    crate_root = "src/main.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "@core_crates//:httparse",
        "@core_crates//:serde_json",
    ],
)

# The binary in each architecture's DashQL.app, Contents/Resources/bin/dashql
platform_binary(
    name = "dashql_aarch64",
    binary = ":dashql",
    platform = "//bazel/platforms:aarch64_macos",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//packages/dashql-native:__pkg__"],
)

platform_binary(
    name = "dashql_x86_64",
    binary = ":dashql",
    platform = "//bazel/platforms:x86_64_macos",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//packages/dashql-native:__pkg__"],
)

# The command line, the session file, the calls against a fake server of the app, the usage and the guide
rust_test(
    name = "test",
    size = "small",
    crate = ":dashql",
)

# Clippy with the safety lints, see //bazel:rust_safety.bzl
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql"],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test(
    name = "rustfmt_test",
    srcs = glob(["**/*.rs"]),
)
