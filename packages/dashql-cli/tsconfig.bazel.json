// The modules and tests with the types of Node, the runtime and the core come from the node_modules of Bazel
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "WebWorker"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ankoh/dashql-protobuf/*": ["./dependencies/dashql-protobuf/*"],
      "@ankoh/dashql-jsonschema/*": ["./dependencies/dashql-jsonschema/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
