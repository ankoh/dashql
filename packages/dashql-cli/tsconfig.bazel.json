// The modules and tests with the types of Node, @ankoh/dashql comes from the node_modules of Bazel with the generated
// packages of its core module
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "WebWorker"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ankoh/dashql-wasm/*": ["../../node_modules/@ankoh/dashql/dependencies/dashql-wasm/*"],
      "@ankoh/dashql-flatbuffers/*": ["../../node_modules/@ankoh/dashql/dependencies/dashql-flatbuffers/*"],
      "@ankoh/dashql-protobuf/*": ["./dependencies/dashql-protobuf/*"],
      "@ankoh/dashql-jsonschema/*": ["./dependencies/dashql-jsonschema/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
