# The core wasm module shipped by @akohn/dashql: the bindings of the core and the shell.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:wasm_tools.bzl", "optimize_wasm", "wasm_bindgen_module")

DASHQL_CORE_WASM_DEPS = [
    "//packages/dashql-core:dashql_core",
    "//packages/dashql-core-script:dashql_core_script",
    "//packages/dashql-core-shell:dashql_core_shell",
    "//packages/dashql-core-profile:dashql_core_profile",
    "//packages/dashql-core-runtime:dashql_core_runtime",
    "//packages/dashql-core-storage:dashql_core_storage",
    "//packages/dashql-parser:dashql_parser",
    "//proto/fb:dashql_buffers_rs",
    "@core_crates//:flatbuffers",
    "@core_crates//:js-sys",
    "@core_crates//:serde",
    "@core_crates//:serde-wasm-bindgen",
    "@core_crates//:serde_bytes",
    "@core_crates//:serde_json",
    "@core_crates//:tsify",
    "@core_crates//:wasm-bindgen",
    "@core_crates//:wasm-bindgen-futures",
]

rust_shared_library(
    name = "dashql_core_wasm",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_core_wasm",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = DASHQL_CORE_WASM_DEPS,
    proc_macro_deps = [
        "@core_crates//:serde_repr",
    ],
)

# The same crate for the host, only for clippy: the bindings compile on the host and fail only when they call JS
rust_library(
    name = "dashql_core_wasm_lint",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_core_wasm",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    tags = ["manual"],
    deps = DASHQL_CORE_WASM_DEPS,
    proc_macro_deps = [
        "@core_crates//:serde_repr",
    ],
)

# Clippy with the safety lints (//bazel:rust_safety_lints) and no warnings, see "The rules" in docs/design/dashql_core.md
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql_core_wasm_lint"],
)

# The unit tests of the parts of the bindings that call no JS, e.g. the marks of the changes, on the host
rust_test(
    name = "dashql_core_wasm_unit_tests",
    size = "small",
    crate = ":dashql_core_wasm_lint",
)

# The wasm_file attribute transitions to wasm32, independent of the host --platforms.
rust_wasm_bindgen(
    name = "dashql_core_bindgen",
    out_name = "dashql_core",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":dashql_core_wasm",
)

wasm_bindgen_module(
    name = "dashql_core_bindgen_wasm",
    bindgen = ":dashql_core_bindgen",
)

# Release: wasm-opt -O3 + strip; dev: copy through unchanged.
optimize_wasm(
    name = "core_wasm",
    src = ":dashql_core_bindgen_wasm",
    out = "dashql_core_bg.wasm",
    visibility = ["//visibility:public"],
)
