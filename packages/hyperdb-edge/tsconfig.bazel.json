// The library without its Node part: against the WebWorker lib, without the DOM and without the types of Node, so the
// DashQL runtime can import it in the browser. src/node/ and src/cli/ are checked with tsconfig.json.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "strict": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/*.ts"],
  "exclude": ["src/*.test.ts"]
}
