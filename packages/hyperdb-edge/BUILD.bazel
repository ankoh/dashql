load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")

# hyperdb-edge: runs SQL on the embedded Hyper of hyperdb-wasm, a command line tool and its library, see
# docs/wip/hyperdb_edge.md. Builds on hyperdb-wasm, not part of it. The library is a source package like
# @ankoh/dashql-sdk, the command runs the JavaScript that :compile writes to dist/.

package(default_visibility = ["//visibility:public"])

# The dev dependencies of package.json: the agent libraries of the stores, not dependencies of the DashQL packages
npm_link_all_packages(name = "node_modules")

_SOURCES = glob(["src/**/*.ts"])

_MODULES = glob(
    ["src/**/*.ts"],
    exclude = ["src/**/*.test.ts"],
)

# The texts of `hyperdb-edge describe`, read at run time from describe/ of the package
copy_to_bin(
    name = "describe_files",
    srcs = glob(["describe/*.md"]),
)

copy_to_bin(
    name = "skill_files",
    srcs = glob(["skill/**"]),
)

copy_to_bin(
    name = "package_json",
    srcs = ["package.json"],
)

_DEPENDENCIES = [
    "//:node_modules/@types/node",
    "//:node_modules/apache-arrow",
    "//:node_modules/hyperdb-wasm",
]

# The SDKs of the adapters in src/adapters/, peer dependencies of those modules only
_ADAPTER_DEPENDENCIES = [
    "//:node_modules/@anthropic-ai/claude-agent-sdk",
    "//:node_modules/@anthropic-ai/sdk",
    "//:node_modules/@modelcontextprotocol/sdk",
    "//:node_modules/zod",
]

typescript_bin.tsc_binary(
    name = "tsc_bin",
)

ts_project(
    name = "compile",
    srcs = _MODULES,
    out_dir = "dist",
    root_dir = "src",
    tsconfig = "tsconfig.compile.json",
    extends = "tsconfig.json",
    tsc = ":tsc_bin",
    tsc_worker = ":tsc_bin",
    transpiler = "tsc",
    validate = False,
    validator = ":tsc_bin",
    deps = _DEPENDENCIES + _ADAPTER_DEPENDENCIES,
)

js_binary(
    name = "hyperdb-edge",
    data = [
        ":compile",
        ":describe_files",
        ":package_json",
        "//:node_modules/apache-arrow",
        "//:node_modules/hyperdb-wasm",
    ],
    entry_point = "dist/cli/main.js",
)

copy_to_bin(
    name = "typecheck_inputs",
    srcs = _SOURCES + [
        "package.json",
        "tsconfig.bazel.json",
        "tsconfig.json",
    ],
)

# The library without src/node/ and src/cli/: against the WebWorker lib, without the DOM and the types of Node
typescript_bin.tsc_test(
    name = "tsc_typecheck_test",
    size = "small",
    args = ["--project", "tsconfig.bazel.json"],
    chdir = "packages/hyperdb-edge",
    data = [":typecheck_inputs"] + _DEPENDENCIES,
)

# Every module and test with the types of Node
typescript_bin.tsc_test(
    name = "tsc_typecheck_node_test",
    size = "small",
    args = ["--project", "tsconfig.json"],
    chdir = "packages/hyperdb-edge",
    data = [
        ":typecheck_inputs",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES + _ADAPTER_DEPENDENCIES,
)

# The tests in Node: the library against the engine, and the compiled command run as separate processes
vitest_bin.vitest_test(
    name = "test",
    size = "large",
    args = [
        "run",
        "--config",
        "vitest.config.mjs",
    ],
    chdir = "packages/hyperdb-edge",
    data = _SOURCES + [
        "vitest.config.mjs",
        ":compile",
        ":describe_files",
        ":package_json",
        ":skill_files",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES,
)

# The stores of agent libraries in stores/, see docs/wip/hyperdb_edge_stores.md. Their libraries are the dev
# dependencies of this package, linked as :node_modules; the library and the command of hyperdb-edge don't use them.
_STORE_SOURCES = glob(["stores/**/*.ts"])

_STORE_DEPENDENCIES = [
    ":node_modules/@anthropic-ai/claude-agent-sdk",
    ":node_modules/@langchain/core",
    ":node_modules/@langchain/langgraph",
    ":node_modules/@langchain/langgraph-checkpoint",
    ":node_modules/@langchain/langgraph-checkpoint-validation",
    ":node_modules/@modelcontextprotocol/sdk",
    ":node_modules/@openai/agents",
    ":node_modules/zod",
]

# The tests share these copies: the Claude Code test runs outside the sandbox, and copies of its own would be actions
# that conflict with those of the other targets
copy_to_bin(
    name = "store_files",
    srcs = _STORE_SOURCES + [
        "stores/tsconfig.json",
        "stores/vitest.claude_code.config.mjs",
        "stores/vitest.config.mjs",
    ],
)

# The stores and their tests with the types of Node, against the libraries
typescript_bin.tsc_test(
    name = "stores_typecheck_test",
    size = "small",
    args = ["--project", "stores/tsconfig.json"],
    chdir = "packages/hyperdb-edge",
    data = [
        ":store_files",
        ":typecheck_inputs",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES + _STORE_DEPENDENCIES,
)

# Each store against the reference of its library, the conformance suite of LangGraph for checkpointers included, and
# under the agent loop of the OpenAI Agents SDK and of LangGraph, with a fake model
vitest_bin.vitest_test(
    name = "stores_test",
    size = "large",
    args = [
        "run",
        "--config",
        "stores/vitest.config.mjs",
    ],
    chdir = "packages/hyperdb-edge",
    data = [
        ":store_files",
        ":typecheck_inputs",
        "//:node_modules/vitest",
    ] + _DEPENDENCIES + _STORE_DEPENDENCIES,
)

# The session store under query() of the Claude Agent SDK, which runs the pinned Claude Code against a fake Messages
# API on loopback, so outside the sandbox of Bazel as the agent tests in tests/agents
vitest_bin.vitest_test(
    name = "stores_claude_code_test",
    size = "large",
    args = [
        "run",
        "--config",
        "stores/vitest.claude_code.config.mjs",
    ],
    chdir = "packages/hyperdb-edge",
    data = [
        ":store_files",
        ":typecheck_inputs",
        "//:node_modules/vitest",
        "//tests/agents:claude",
    ] + _DEPENDENCIES + _STORE_DEPENDENCIES,
    env = {
        "CLAUDE_BINARY": "$(rlocationpath //tests/agents:claude)",
    },
    no_copy_to_bin = ["//tests/agents:claude"],
    tags = ["no-sandbox"],
)
