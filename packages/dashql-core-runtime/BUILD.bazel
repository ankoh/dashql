# The state of DashQL in Rust on top of the core, linked into the core module: the scripts of a workbook, the
# connections, the computations and the services on a host. The storage is //packages/dashql-core-storage, see
# docs/design/dashql_core.md.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")

rust_library(
    name = "dashql_core_runtime",
    srcs = glob(["src/**/*.rs"]),
    # The bundled function catalog of Hyper, see src/catalog_loader/prefetched_hyper_functions.rs
    compile_data = ["src/catalog_loader/prefetched_hyper_functions.sql"],
    crate_name = "dashql_core_runtime",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-core-profile:dashql_core_profile",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:arrow-array",
        "@core_crates//:arrow-cast",
        "@core_crates//:arrow-ipc",
        "@core_crates//:arrow-schema",
        "@core_crates//:base64",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde",
        "@core_crates//:serde_json",
    ],
)

rust_test(
    name = "dashql_core_runtime_unit_tests",
    size = "small",
    crate = ":dashql_core_runtime",
)

# Clippy with the safety lints (//bazel:rust_safety_lints) and no warnings, see "The rules" in docs/design/dashql_core.md
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql_core_runtime"],
)

# The tests of the runtime in one libtest binary, a module per file of tests/ (tests/main.rs), so that a change of the
# runtime or the core links one test binary instead of one per file. Run the tests of a file with --test_arg=<file>::
rust_test(
    name = "tests",
    size = "small",
    srcs = glob(["tests/*_test.rs"]) + ["tests/main.rs"],
    # The recordings of Trino are compiled in with include_str!
    compile_data = ["//tests/snapshots/profiles/trino/recordings:files"],
    crate_root = "tests/main.rs",
    # The generated spec of the Data 360 extension
    data = ["//extensions/d360-api:files"],
    edition = "2021",
    deps = [
        ":dashql_core_runtime",
        "//packages/dashql-core-profile:dashql_core_profile",
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "//proto/fb:dashql_buffers_rs",
        "@core_crates//:arrow-array",
        "@core_crates//:arrow-ipc",
        "@core_crates//:arrow-schema",
        "@core_crates//:base64",
        "@core_crates//:flatbuffers",
        "@core_crates//:serde_json",
    ],
)

# The planner and dataflow snapshots: one target per category, each a libtest-mimic binary
DASHQL_CORE_RUNTIME_SNAPSHOT_TESTS = {
    "dataflow_snapshot_test": ("dataflow_snapshots.rs", "//tests/snapshots/dataflow:files"),
    "planner_snapshot_test": ("planner_snapshots.rs", "//tests/snapshots/planner:files"),
}

[rust_test(
    name = name,
    size = "small",
    srcs = ["tests/" + src],
    data = [data],
    edition = "2021",
    use_libtest_harness = False,
    deps = [
        ":dashql_core_runtime",
        "//tests/snapshots:dashql_snapshots",
        "//proto/fb:dashql_buffers_rs",
    ],
) for name, (src, data) in DASHQL_CORE_RUNTIME_SNAPSHOT_TESTS.items()]

# Executes the planned SQL of the planner snapshots with script references in Hyper, through the C ABI
# //tests/hyper:hyper_ffi over the Hyper C++ API.
rust_test(
    name = "planner_validation_hyper_test",
    size = "medium",
    srcs = ["tests/planner_validation_hyper.rs"],
    data = [
        "//tests/hyper:hyperd",
        "//tests/snapshots/planner:files",
    ],
    edition = "2021",
    env = {"HYPERD_BINARY": "$(rootpath //tests/hyper:hyperd)"},
    target_compatible_with = select({
        "//bazel/platforms:linux_x86_64": [],
        "//bazel/platforms:macos_arm64": [],
        "//bazel/platforms:macos_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    use_libtest_harness = False,
    deps = [
        ":dashql_core_runtime",
        "//tests/snapshots:dashql_snapshots",
        "//tests/hyper:hyper_ffi_rs",
        "//proto/fb:dashql_buffers_rs",
    ],
)

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test(
    name = "rustfmt_test",
    srcs = glob(["**/*.rs"]),
)
