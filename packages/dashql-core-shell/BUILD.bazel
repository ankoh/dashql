# The DashQL shell: the history of its prompts, the check whether a prompt is complete, dot commands, the execution
# protocol of queries and dot commands, and the records of their output with the tables of the previews of query
# results. Its bindings are part of //packages/dashql-core-bindings.
#
# All third-party crates resolve from the isolated @core_crates universe (MODULE.bazel).

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:rust_safety.bzl", "rust_safety_test")
load("//bazel:rustfmt.bzl", "rustfmt_test")

rust_library(
    name = "dashql_core_shell",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "dashql_core_shell",
    crate_root = "src/lib.rs",
    edition = "2021",
    lint_config = "//bazel:rust_safety_lints",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/dashql-core:dashql_core",
        "//packages/dashql-parser:dashql_parser",
        "@core_crates//:arrow-array",
        "@core_crates//:arrow-cast",
        "@core_crates//:arrow-ipc",
        "@core_crates//:arrow-schema",
        "@core_crates//:unicode-segmentation",
        "@core_crates//:unicode-width",
    ],
)

rust_test(
    name = "dashql_core_shell_unit_tests",
    size = "small",
    crate = ":dashql_core_shell",
)

# Clippy with the safety lints, see //bazel:rust_safety.bzl
rust_safety_test(
    name = "clippy_test",
    deps = [":dashql_core_shell"],
)

# Tests of the shell, one libtest binary per test file
DASHQL_CORE_SHELL_TESTS = [
    "shell_arrow_renderer_test",
    "shell_session_test",
]

[rust_test(
    name = name,
    size = "small",
    srcs = ["tests/" + name + ".rs"],
    crate_root = "tests/" + name + ".rs",
    edition = "2021",
    deps = [
        ":dashql_core_shell",
        "//packages/dashql-core:dashql_core",
        "@core_crates//:arrow-array",
        "@core_crates//:arrow-ipc",
        "@core_crates//:arrow-schema",
    ],
) for name in DASHQL_CORE_SHELL_TESTS]

# rustfmt of the Rust files of the package, see //bazel:rustfmt.bzl
rustfmt_test()
