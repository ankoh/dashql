    chdir = "packages/dashql-app",
    out_dirs = ["coverage_pages"],
    visibility = ["//visibility:private"],
)

copy_to_directory(
    name = "coverage_pages",
    srcs = [
        ":coverage_pages_vite",
        "_headers",
        "static/config.json",
    ],
    out = "coverage_pages_deploy",
    replace_prefixes = {
        "coverage_pages": "",
        "packages/dashql-app/_headers": "_headers",
        "packages/dashql-app/static": "static",
    },
    visibility = ["//visibility:private"],
)

# The driver of the browser tests of the app, with the page tests after the test files
BROWSER_TEST_DATA = [
    "test/browser_coverage.mjs",
    "test/browser_page_tests.mjs",
]

# A suite runs a browser with an embedded Hyper per page, about two cores each: a shard of the test files per four cores
# (at most four) and, with several shards, half as many pages for the page tests next to them, see
# test/browser_test_driver.mjs. Twelve cores for the six pages of a host with sixteen, so two suites don't share them;
# two suites on the same cores timed tests out. A runner of CI with four cores runs a suite alone on one page at a time.
BROWSER_TEST_TAGS = ["cpu:12"]

browser_test(
    name = "test_chromium",
    browser = "chromium",
    bundle = ":pages",
    data = BROWSER_TEST_DATA,
    entry_point = "test/browser_test_driver.mjs",
    tags = BROWSER_TEST_TAGS,
)

browser_test(
    name = "test_firefox",
    browser = "firefox",
    bundle = ":pages",
    data = BROWSER_TEST_DATA,
    entry_point = "test/browser_test_driver.mjs",
    tags = BROWSER_TEST_TAGS,
)

# Line coverage of the app sources in the browser tests, published at https://coverage.dashql.app.
# Writes coverage.dat (LCOV) and coverage_summary.txt to the undeclared test outputs.
browser_test(
    name = "coverage_chromium",
    browser = "chromium",
    bundle = ":coverage_pages",
    data = BROWSER_TEST_DATA,
    entry_point = "test/browser_test_driver.mjs",
    env = {"DASHQL_BROWSER_COVERAGE": "1"},
    tags = BROWSER_TEST_TAGS + ["manual"],
)

vite_bin.vite_binary(
    name = "_vite_bin",
    visibility = ["//visibility:private"],
)

# The dev server: `pnpm dev`, which runs it under ibazel in an output base of its own. It runs Vite in a sandbox, a copy
# of the inputs of the builds of the app, and ibazel syncs the files that a rebuild changes into it. The npm packages in
# the sandbox link into bazel-out, hence the output base of its own, see docs/agents/build_bazel_targets.md
js_run_devserver(
    name = "dev",
    tool = ":_vite_bin",
    args = ["--config", "vite.config.generated.mts"],
    chdir = package_name(),
    data = _vite_web_deps + glob(["types/**/*.d.ts"]) + [
        "tsconfig.bazel.json",
        "//packages/dashql:dev_srcs",
        "//packages/dashql-react:dev_srcs",
        # The type checker of the dev server resolves the imports and the types of tsconfig.bazel.json
        "//:node_modules",
    ],
    visibility = ["//visibility:public"],
)

# Compares the experimental wasm backend of hyperdb-wasm with its default backend
js_binary(
    name = "bench_hyperdb_wasm_backend",
    data = [
        "//:node_modules/apache-arrow",
        "//:node_modules/hyperdb-wasm",
    ],
    entry_point = "utils/bench_hyperdb_wasm_backend.mjs",
)

# ESLint with the rules of the root eslint.config.mjs, see docs/agents/build_bazel_targets.md
eslint_test()
