    name = "srcs",
    srcs = glob([
        "src/**/*.css",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.sql",
        "entrypoints/*.html",
        "_headers",
        "_redirects",
        "static/**/*.svg",
        "static/**/*.png",
        "static/**/*.ico",
        "static/**/*.webmanifest",
        "static/**/*.xml",
        "static/**/*.sql",
        "static/**/*.html",
        "static/config.json",
