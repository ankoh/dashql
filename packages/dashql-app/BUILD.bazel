# Stage the declared SQL snippets for the @dashql/snippets alias, the app bundles them as text.
# A fresh output directory, so snippets deleted from examples/snippets don't linger in bazel-bin.
copy_to_directory(
    name = "example_snippets",
    srcs = ["//:example_snippets"],
    out = "dependencies/snippets",
    replace_prefixes = {
        "examples/snippets": "",
    },
    visibility = ["//visibility:private"],
)

# Stage the extensions for the @dashql/extensions alias: the app bundles their generated specs and their snippets.
copy_to_directory(
    name = "extensions",
    srcs = ["//extensions/d360-api:files"],
    out = "dependencies/extensions",
    replace_prefixes = {
        "extensions": "",
    },
    visibility = ["//visibility:private"],
)

# The brand assets are also used by the website (//packages/dashql-org)
exports_files(["utils/generate_svg_symbols.py"])
filegroup(
    name = "svg_logo_files",
    srcs = glob(["static/svg/logo/*.svg"]),
    visibility = ["//packages/dashql-org:__pkg__"],
)
copy_to_bin(
    name = "favicons",
    srcs = glob(["static/favicons/dashql/*"]),
    visibility = ["//packages/dashql-org:__pkg__"],
)
filegroup(
    name = "svg_icon_files",
    srcs = glob(["static/svg/icons/*.svg"]),
    visibility = ["//packages/dashql-org:__pkg__"],
)
genrule(
    name = "dep_svg_symbols",
    srcs = [":svg_logo_files", ":svg_icon_files"],
    outs = ["dependencies/svg-symbols/symbols.generated.svg"],
    cmd = "python3 $(location utils/generate_svg_symbols.py) --output $@ $(locations :svg_logo_files) $(locations :svg_icon_files)",
    tools = ["utils/generate_svg_symbols.py"],
    visibility = ["//visibility:private"],
)

# The config of Vite for the builds and the dev server with the version of the build. The paths of @akohn/dashql and
# @akohn/dashql-react differ between them, the config picks them by the command of Vite.
genrule(
    name = "vite_config",
    srcs = [
        "vite.config.tpl.ts",
        "@dashql_app_version//:version.env",
        "//:package.json",
        ":dep_svg_symbols",
    ],
    outs = ["vite.config.generated.mts"],
    cmd = """
        VERSION=$$(awk -F= '$$1=="DASHQL_VERSION_TEXT"{print $$2}' "$(location @dashql_app_version//:version.env)")
        COMMIT=$$(awk -F= '$$1=="DASHQL_VERSION_COMMIT"{print $$2}' "$(location @dashql_app_version//:version.env)")
        HYPERDB_WASM_VERSION=$$(awk -F'"' '/"hyperdb-wasm"/{print $$4; exit}' "$(location //:package.json)")

        sed -e "s|__DASHQL_VERSION__|$${VERSION}|g" \\
            -e "s|__DASHQL_COMMIT__|$${COMMIT}|g" \\
            -e "s|__HYPERDB_WASM_VERSION__|$${HYPERDB_WASM_VERSION}|g" \\
            $(location vite.config.tpl.ts) > $@
    """,
)

genrule(
    name = "browser_test_files",
    srcs = glob(["src/**/*.test.ts", "src/**/*.test.tsx"]),
    outs = ["browser_test_files.txt"],
    cmd = """
        for src in $(SRCS); do
            printf '%s\\n' "$${src#packages/dashql-app/src/}"
        done > $@
    """,
)

# The tests of the runtime and of the platform of @akohn/dashql that the browser tests run as well, relative to its src/
genrule(
    name = "dashql_browser_test_files",
    srcs = ["//packages/dashql:browser_test_files"],
    outs = ["dashql_browser_test_files.txt"],
    cmd = """
        for src in $(SRCS); do
            printf '%s\\n' "$${src#packages/dashql/src/}"
        done > $@
    """,
)

# The tests of the components of @akohn/dashql-react that the browser tests run as well, relative to its src/
genrule(
    name = "dashql_react_browser_test_files",
    srcs = ["//packages/dashql-react:browser_test_files"],
    outs = ["dashql_react_browser_test_files.txt"],
    cmd = """
        for src in $(SRCS); do
            printf '%s\\n' "$${src#packages/dashql-react/src/}"
        done > $@
    """,
)

genrule(
    name = "browser_test_stylesheets",
    srcs = glob(["src/**/*.css"]),
    outs = ["browser_test_stylesheets.txt"],
    cmd = """
        for src in $(SRCS); do
            printf '%s\\n' "$${src#packages/dashql-app/src/}"
        done > $@
    """,
)

# The components that show a model import nothing of the runtime, see docs/agents/writing_components.md
js_test(
    name = "component_boundary_test",
    data = [":srcs"],
    entry_point = "test/component_boundary_test.mjs",
)

