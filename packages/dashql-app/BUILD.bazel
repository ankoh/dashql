    allow_js = True,
    validate = False,
    validator = ":_tsc_bin",
    deps = [
        "//:node_modules",
        "//:node_modules/@akohn/dashql",
        "//:node_modules/@akohn/dashql-react",
    ],
    visibility = ["//visibility:public"],
)

