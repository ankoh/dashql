    chdir = "packages/dashql-app",
    out_dirs = ["pages"],
    visibility = ["//visibility:private"],
)

copy_to_directory(
    name = "pages",
    srcs = [
        ":pages_vite",
        "//:NOTICE",
        "_headers",
        "_redirects",
        "static/404.html",
        "static/config.json",
