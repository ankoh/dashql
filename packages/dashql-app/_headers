# COOP and COEP isolate a top-level page in every browser. Document-Isolation-Policy also isolates a page that
# another site embeds in an iframe (Chromium 137+), with the same subresource rule as COEP.
# See docs/design/document_isolation_policy.md.
/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Document-Isolation-Policy: isolate-and-require-corp
  Access-Control-Allow-Origin: *

# A worker takes the Content-Security-Policy of its script response, the <meta> policy of the page does not reach it.
# A page ignores the policy of a script that it loads, so the rule covers every script. The core batch worker compiles
# Wasm, the HyperDB worker imports its engine from a blob: URL and reads mounted files with fetches of blob: URLs.
# See docs/design/app_csp.md.
/static/js/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' blob: data: http: https: ws: wss:

# The embed is framed by the hosts listed here, see docs/wip/embeds.md: Slack, and ChatGPT, whose MCP App views run
# under <ui.domain>.web-sandbox.oaiusercontent.com inside chatgpt.com. A browser checks every frame above the embed
# against the list. Keep all hosts in this one header: a second policy with frame-ancestors would have to pass too.
# frame-ancestors has no effect in a <meta> policy, so it is a header. Pages serves embed.html as /embed.
/embed
  Content-Security-Policy: frame-ancestors 'self' https://*.slack.com https://*.slack-gov.com https://*.slack-mcps.com https://slack-mcps-host.com https://chatgpt.com https://*.web-sandbox.oaiusercontent.com
  Cache-Control: public, max-age=0, must-revalidate

/embed.html
  Content-Security-Policy: frame-ancestors 'self' https://*.slack.com https://*.slack-gov.com https://*.slack-mcps.com https://slack-mcps-host.com https://chatgpt.com https://*.web-sandbox.oaiusercontent.com
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints files in these output directories. Their URLs change with their contents, so
# browsers can retain successful responses across deployments. Keep mutable static/config.json
# outside these rules.
/static/assets/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/static/img/*
  Cache-Control: public, max-age=31536000, immutable

/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/scripts/*
  Cache-Control: public, max-age=31536000, immutable

/static/wasm/*
  Cache-Control: public, max-age=31536000, immutable

# Serve uncompressed WebAssembly with the MIME type required for streaming compilation.
/static/wasm/*.wasm
  Content-Type: application/wasm

# The pages build compresses all WebAssembly with Brotli (precompressWasm in vite.config.tpl.ts) and keeps the
# `.br` suffix. The browser decompresses it before fetch() and WebAssembly.instantiateStreaming() see it.
/static/wasm/*.br
  Content-Encoding: br
  Content-Type: application/wasm

# Vite preserves the .br suffix but inserts the content hash before it.
/static/assets/hyperdb-wasm.wasm.*.br
  Content-Encoding: br
  Content-Type: application/wasm

# Native release artifacts are versioned and immutable when hosted by this project.
/releases/*
  Cache-Control: public, max-age=31536000, immutable

# Entrypoints must be revalidated before reuse.
/
  Cache-Control: public, max-age=0, must-revalidate

