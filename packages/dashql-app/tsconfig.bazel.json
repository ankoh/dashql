{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "noImplicitAny": true,
        "esModuleInterop": false,
        "downlevelIteration": true,
        "isolatedModules": true,
        "ignoreDeprecations": "6.0",
        "strict": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@akohn/dashql-protobuf": ["../../node_modules/@akohn/dashql/dependencies/dashql-protobuf"],
            "@akohn/dashql-protobuf/*": ["../../node_modules/@akohn/dashql/dependencies/dashql-protobuf/*"],
            "@akohn/dashql-jsonschema": ["../../node_modules/@akohn/dashql/dependencies/dashql-jsonschema"],
            "@akohn/dashql-jsonschema/*": ["../../node_modules/@akohn/dashql/dependencies/dashql-jsonschema/*"],
            "@akohn/dashql-wasm/*": ["../../node_modules/@akohn/dashql/dependencies/dashql-wasm/*"],
            "@akohn/dashql-flatbuffers/*": ["../../node_modules/@akohn/dashql/dependencies/dashql-flatbuffers/*"]
        },
        "types": ["node", "vitest/globals", "vite/client"],
        "lib": ["es6", "es2022", "dom"],
        "allowJs": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "types/**/*"
    ]
}
