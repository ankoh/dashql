// For editors: the paths of the root tsconfig.json, which point into bazel-bin for the generated packages. Bazel checks
// the modules with tsconfig.bazel.json and the tests with tsconfig.bazel.test.json, the modules of Node have their own.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/*/node/**"
  ]
}
