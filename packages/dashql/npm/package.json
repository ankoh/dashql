{
  "name": "@akohn/dashql",
  "version": "0.0.19-dev.250",
  "description": "DashQL in TypeScript: the WebAssembly bindings of its SQL core, its runtime and the platforms of the runtime",
  "type": "module",
  "license": "MPL-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankoh/dashql.git",
    "directory": "packages/dashql"
  },
  "homepage": "https://github.com/ankoh/dashql/tree/main/packages/dashql#readme",
  "bugs": { "url": "https://github.com/ankoh/dashql/issues" },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./buffers": { "types": "./dist/core/buffers.d.ts", "import": "./dist/core/buffers.js" },
    "./browser-worker": { "types": "./dist/core/browser_worker.d.ts", "import": "./dist/core/browser_worker.js" },
    "./batch-worker": "./dist/core/batch_worker.js",
    "./wasm": "./dist/wasm/dashql_core.wasm",
    "./dataflow-wasm": "./dist/wasm/dashql_dataflow.wasm",
    "./wasm/glue": { "types": "./dist/wasm/dashql_core.d.ts", "import": "./dist/wasm/dashql_core.js" },
    "./runtime": { "types": "./dist/runtime/runtime.d.ts", "import": "./dist/runtime/runtime.js" },
    "./node": { "types": "./dist/runtime/node/node_platform.d.ts", "import": "./dist/runtime/node/node_platform.js" },
    "./runtime/*": { "types": "./dist/runtime/*.d.ts", "import": "./dist/runtime/*.js" },
    "./platform/*": { "types": "./dist/platform/*.d.ts", "import": "./dist/platform/*.js" }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@zip.js/zip.js": "^2.24.0",
    "apache-arrow": "^21.2.0",
    "flatbuffers": "25.9.23",
    "immutable": "^5.2.1"
  },
  "peerDependencies": {
    "hyperdb-wasm": "0.0.27368-dev.wasm.ge0a6b4a9",
    "vega-lite": "^6.5.0"
  },
  "peerDependenciesMeta": {
    "hyperdb-wasm": { "optional": true },
    "vega-lite": { "optional": true }
  }
}
