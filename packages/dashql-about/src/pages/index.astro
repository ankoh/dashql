---
import FeatureSection from '../components/feature_section.astro';
import LinkButton from '../components/link_button.astro';
import ParticleHero from '../components/particle_hero.astro';
import SiteLayout from '../layouts/site_layout.astro';
import styles from './page.module.css';
---

<SiteLayout title="DashQL" description="DashQL, it's all just SQL." underHeader>
    <ParticleHero>
        <h1 class={styles.headline}>
            <span class={styles.headline_setup}>It's all just <span class={styles.headline_sql}>SQL</span>...</span>
            <span class={styles.headline_punchline}>always has been<span class={styles.caret} aria-hidden="true"></span></span>
        </h1>
        <div class={styles.actions}>
            <LinkButton href="https://dashql.app">Use it</LinkButton>
            <span class={styles.note}>No signup required</span>
        </div>
    </ParticleHero>

    <FeatureSection id="editor" eyebrow="Editor" title="An editor that understands SQL">
        <p>DashQL parses and analyzes your scripts while you type. It completes names, resolves tables and columns, and points out what doesn't fit.</p>
    </FeatureSection>

    <FeatureSection id="hyper" eyebrow="Engine" title="Hyper, right in your browser">
        <p>Queries run on Hyper, compiled to WebAssembly. Your data stays on your machine and results come back in milliseconds.</p>
    </FeatureSection>

    <FeatureSection id="visualize" eyebrow="Visualize" title="Charts that live in SQL comments">
        <p>Describe a chart next to the query that feeds it. The visualization travels with the script and updates with every run.</p>
    </FeatureSection>

    <FeatureSection id="agents" eyebrow="Agents" title="Work alongside agents">
        <p>Agents read and edit your scripts through DashQL, and you keep the overview of every change they make.</p>
    </FeatureSection>
</SiteLayout>
