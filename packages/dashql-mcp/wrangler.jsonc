// One Worker per channel, each on its own path of mcp.dashql.app, see README.md.
//   wrangler deploy --env dev | stable | latest
{
  "name": "dashql-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "dashql-mcp-dev",
      "routes": [{ "pattern": "mcp.dashql.app/dev/*", "zone_name": "dashql.app" }],
      "vars": { "CHANNEL": "dev", "APP_ORIGIN": "https://dev.dashql.app" }
    },
    "stable": {
      "name": "dashql-mcp-stable",
      "routes": [{ "pattern": "mcp.dashql.app/stable/*", "zone_name": "dashql.app" }],
      "vars": { "CHANNEL": "stable", "APP_ORIGIN": "https://stable.dashql.app" }
    },
    "latest": {
      "name": "dashql-mcp-latest",
      "routes": [{ "pattern": "mcp.dashql.app/latest/*", "zone_name": "dashql.app" }],
      "vars": { "CHANNEL": "latest", "APP_ORIGIN": "https://dashql.app" }
    }
  }
}
