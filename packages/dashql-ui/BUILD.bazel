load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:typescript/package_json.bzl", typescript_bin = "bin")

# Code, tokens and fonts shared by the app (//packages/dashql-app) and the website (//packages/dashql-org).
# A source package, nothing is compiled: consumers bundle the TypeScript and the stylesheets themselves.
# Linked as //:node_modules/@ankoh/dashql-ui, their dev servers read packages/dashql-ui directly. The particle flow
# imports three, consumers resolve it from the root node_modules, so they have to depend on //:node_modules/three.

package(default_visibility = ["//visibility:public"])

_SOURCES = glob(["src/**/*.json", "src/**/*.ts"])

copy_to_bin(
    name = "typecheck_inputs",
    srcs = _SOURCES + ["package.json", "tsconfig.json"],
)

typescript_bin.tsc_test(
    name = "tsc_typecheck_test",
    size = "small",
    args = ["--project", "tsconfig.json"],
    chdir = "packages/dashql-ui",
    data = [
        ":typecheck_inputs",
        "//:node_modules/@types/three",
        "//:node_modules/three",
    ],
)

npm_package(
    name = "npm_package",
    package = "@ankoh/dashql-ui",
    srcs = ["package.json"] + _SOURCES + glob([
        "fonts/*.css",
        "fonts/*.ttf",
        "fonts/*.txt",
        "styles/*.css",
        "styles/flavors/*.css",
    ]),
    include_transitive_sources = False,
    include_transitive_types = False,
)
