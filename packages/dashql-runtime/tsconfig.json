// For editors: the paths of the root tsconfig.json, which point into bazel-bin for the core and the generated packages.
// Bazel checks the runtime with tsconfig.bazel.json and its tests with tsconfig.bazel.test.json, src/node has its own.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/node/**"
  ]
}
