include "dashql/parsed_script.fbs";
include "dashql/markdown.fbs";
include "dashql/visualization.fbs";

namespace dashql.buffers.execution;

enum ScriptCompilationStatementKind: uint8 {
    QUERY,
    VISUALIZE,
}

enum ScriptCompilationErrorCode: uint8 {
    SCANNER_ERROR,
    PARSER_ERROR,
    EMPTY_SCRIPT,
    LAST_STATEMENT_NOT_EXECUTABLE,
    EXTENSIONS_DISABLED,
    VISUALIZATION_METADATA_UNAVAILABLE,
    FORMAT_ERROR,
}

table ScriptCompilationError {
    code: ScriptCompilationErrorCode;
    statement_id: uint32 = 4294967295;
    ast_node_id: uint32 = 4294967295;
    text_span: parser.TextSpan;
    message: string;
}

table CompiledVisualization {
    renderer: string;
    vegalite_spec: string;
    markdown_spec: visualization.MarkdownSpec;
    dashboard: visualization.DashboardSpec;
    table_spec: visualization.TableSpec;
}

table ScriptCompilationResult {
    kind: ScriptCompilationStatementKind = QUERY;
    terminal_statement_id: uint32 = 4294967295;
    sql: string;
    visualization: CompiledVisualization;
    errors: [ScriptCompilationError];
}
