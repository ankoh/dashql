enum StatementType: uint8 {
    NONE = 0,
    CREATE_TABLE = 1,
    CREATE_TABLE_AS = 2,
    CREATE_VIEW = 3,
    SELECT = 4,
    SET = 5,
    CREATE_FUNCTION = 7,
    EXPLAIN = 8,
    DROP_TABLE = 9,
    DROP_VIEW = 10,
    SELECT_INTO = 11,
    ATTACH_DATABASE = 12,
    INSERT = 13,
    DELETE = 14,
}

enum StatementTargetType: uint8 {
    NONE,
    TABLE,
    VIEW,
}

table StatementTarget {
    database_name: string;
    schema_name: string;
    relation_name: string;
}

table AttachDatabaseStatement {
    path: string;
    alias: string;
    local: bool;
}

struct Node {
    symbol_span: SymbolSpan;
    node_type: NodeType = NONE;
    attribute_key: AttributeKey = NONE;
    parent: uint32 = 0;
    children_begin_or_value: uint32 = 0;
    children_count: uint32 = 0;
}

table Error {
    text_span: TextSpan;
    symbol_span: SymbolSpan;
    message: string;
    hint: string;
}

/// The kind of a comment block
enum CommentBlockType: uint8 {
    /// An ordinary comment
    COMMENT = 0,
    /// A `@dashql:<tag>` region, the parser does not interpret the tag or the content.
    /// Readers pick blocks by tag name and parse the content, e.g. as JSON.
    DASHQL_TAG = 1,
}

/// A group of comments: a single block comment or a run of line comments on consecutive lines.
/// Tagged regions (`-- @dashql:<tag>` ... `-- @dashql:end`, or `/* @dashql:<tag> ... */`) are split into their own blocks.
struct CommentBlock {
    block_type: CommentBlockType;
    /// Byte span of the whole block in the source text, including comment markers and tag lines
    text_span: TextSpan;
    /// Byte span of the tag name (e.g. `description`), empty for ordinary comments
    tag_span: TextSpan;
    /// Slice into ParsedScript.comments
    comments_begin: uint32;
    comments_count: uint32;
    /// Slice into ParsedScript.comment_lines
    lines_begin: uint32;
    lines_count: uint32;
}

table Statement {
    statement_type: StatementType;
    root_node: uint32;
    nodes_begin: uint32;
    node_count: uint32;
    // Byte span of the statement SQL in the source text, excluding its separator and comments.
    statement_span: TextSpan;
    // Slice into ParsedScript.comments containing this statement's description comments.
    description_begin: uint32;
    description_count: uint32;
    // Slice into ParsedScript.comment_blocks containing the blocks of this statement's description comments.
    description_blocks_begin: uint32;
    description_blocks_count: uint32;
    // Normalized metadata for statement consumers that do not need to traverse the AST.
    target_type: StatementTargetType;
    target: StatementTarget;
    attach_database: AttachDatabaseStatement;
}

enum ScannerTokenType: uint8 {
    NONE,
    KEYWORD,
    LITERAL_INTEGER,
    LITERAL_FLOAT,
    LITERAL_STRING,
    LITERAL_BINARY,
    LITERAL_HEX,
    LITERAL_BOOLEAN,
    OPERATOR,
    IDENTIFIER,
    COMMENT,
    DOT,
    DOT_TRAILING,
}

table ScannerTokens {
    // Parser symbols only. Indexes in these arrays are the indexes used by SymbolSpan.
    // Comments are trivia and are stored separately in ParsedScript.comments.
    token_offsets: [uint32];
    token_lengths: [uint32];
    token_types: [ScannerTokenType];
    token_breaks: [uint32];
}

table ScannedScript {
    external_id: uint32;
    line_breaks: [TextSpan];
    errors: [Error];
    comments: [TextSpan];
}

table ParsedScript {
    external_id: uint32;
    nodes: [Node];
    statements: [Statement];
    scanner_errors: [Error];
    parser_errors: [Error];
    tokens: ScannerTokens;
    line_breaks: [TextSpan];
    comments: [TextSpan];
    /// The comments grouped into blocks, in script order
    comment_blocks: [CommentBlock];
    /// The content lines of all comment blocks, without comment markers, gutters and tag lines.
    /// Joining the lines of a block with line breaks gives its text.
    comment_lines: [TextSpan];
}
