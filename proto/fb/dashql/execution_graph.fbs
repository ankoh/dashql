include "dashql/catalog.fbs";
include "dashql/parsed_script.fbs";
include "dashql/script_compilation.fbs";
include "dashql/analyzed_script.fbs";

namespace dashql.buffers.execution;

enum ExecutionGraphAccessMode: uint8 { READ, WRITE, DDL }
/// MATERIALIZATION orders the query of a materialized script before the statements that scan it, SEQUENCE keeps the
/// statement order of a script in a plan of target scripts
enum ExecutionGraphEdgeReason: uint8 { READ_AFTER_WRITE, WRITE_AFTER_READ, WRITE_AFTER_WRITE, DDL, BARRIER, MATERIALIZATION, SEQUENCE }
/// A LOCAL connection is the embedded Hyper that can scan the materialized results of scripts of other connections
enum ExecutionGraphConnectionKind: uint8 { REMOTE, LOCAL }
enum ExecutionGraphEntityType: uint8 { DEFERRED = 0, DATABASE = 1, SCHEMA = 2, TABLE = 3, COLUMN = 4, FUNCTION = 5 }

struct ExecutionGraphCatalogObjectID {
    object_type: ExecutionGraphEntityType;
    object_id: uint64;
    sub_object_id: uint32;
}

table ExecutionGraphConnection {
    connection_id: string;
    kind: ExecutionGraphConnectionKind;
}

table ExecutionGraphScript {
    script_id: uint32;
    text_version: uint64;
    analyzed_text_version: uint64;
    analyzed_catalog_revision: uint64;
    /// The name of the script, `foo` for `foo.sql`, the name of the table parameter `:foo` that reads its result
    name: string;
    /// The connection index
    connection: uint32;
    /// Was the analysis of the script used? Plans of target scripts use the targets and the scripts they reference.
    planned: bool;
    /// Is the script a target of the plan? A plan of the session targets the scripts whose results the host doesn't
    /// provide.
    target: bool;
    /// The cache signature of the AST of the script, empty if it does not parse
    signature: string;
    /// Can the result of the script be cached? Its statements are queries and the scripts it references can be cached.
    cacheable: bool;
    /// The last statement of the script, the query that a script reference reads
    terminal_statement_id: uint32 = 4294967295;
    /// The scripts that the script references, in the order of their first reference
    referenced_scripts: [uint32];
}

/// The result of a script that a statement of another connection scans as Parquet file
table ExecutionGraphMaterialization {
    /// The script whose result is materialized
    script: uint32;
    /// The node that computes the result, absent if the host provides the result
    node: uint32 = 4294967295;
    /// The path that the host mounts the Parquet file at
    path: string;
}

/// An attachment of the session, a Parquet file that the table parameter `:name` reads
table ExecutionGraphAttachment {
    /// The name, `foo` for `foo.parquet`
    name: string;
    /// The file name below the attachment prefix
    file: string;
    /// The path that a statement scans
    path: string;
}

/// A table parameter that references a script or an attachment
table ExecutionGraphScriptReference {
    /// The node of the statement with the reference
    node: uint32 = 4294967295;
    /// The referencing script and the parameter in its text
    consumer_script: uint32;
    text_span: dashql.buffers.parser.TextSpan;
    /// The referenced script, absent for an attachment
    script: uint32 = 4294967295;
    /// The parameter name
    parameter: string;
    /// The name of the common table expression that stands for the referenced script or attachment
    cte_name: string;
    /// The materialization the reference scans, absent if the script is inlined
    materialization: uint32 = 4294967295;
    /// The referenced attachment
    attachment: uint32 = 4294967295;
}

table ExecutionGraphEntity {
    catalog_object_id: ExecutionGraphCatalogObjectID (required);
    catalog_database_id: uint32;
    catalog_schema_id: uint32;
    database_name: string;
    schema_name: string;
    name: string;
    /// The connection index, entities of different connections are different
    connection: uint32;
}

table ExecutionGraphUnresolvedReference {
    database_name: string;
    schema_name: string;
    name: string;
    /// The connection index
    connection: uint32;
}

table ExecutionGraphAccess {
    entity: uint32 = 4294967295;
    unresolved_reference: uint32 = 4294967295;
    mode: ExecutionGraphAccessMode;
}

table ExecutionGraphNode {
    script: uint32;
    statement_id: uint32;
    statement_type: dashql.buffers.parser.StatementType;
    sql: string;
    produces_output: bool;
    barrier: bool;
    accesses: [ExecutionGraphAccess];
    visualization: CompiledVisualization;
    /// The changes of the catalog of the connection once the statement succeeded
    catalog_changes: [dashql.buffers.catalog.CatalogChange];
    /// The connection index
    connection: uint32;
    /// The materialization that the result of the node is written to
    materialization: uint32 = 4294967295;
    /// The materializations to mount before the node runs
    inputs: [uint32];
    /// Is the node the terminal output of its script, the result of the script?
    script_result: bool;
    /// The scripts whose queries the statement inlines, also those that inlined queries reference, in the order of
    /// their common table expressions
    inlined_scripts: [uint32];
    /// The attachments that the statement scans, also those that inlined queries read
    attachments: [uint32];
    /// A call of a client function: what `describe_client_function_call` says, as JSON, with the values of the inputs
    /// filled in. The host runs it instead of sending `sql`, no backend sees the statement.
    client_function_call: string;
}

table ExecutionGraphEdge {
    from: uint32;
    to: uint32;
    entity: uint32 = 4294967295;
    unresolved_reference: uint32 = 4294967295;
    reason: ExecutionGraphEdgeReason;
}

table ExecutionGraphDiagnostic {
    node: uint32 = 4294967295;
    message: string;
    /// The script, set with the node and for diagnostics of script references
    script: uint32 = 4294967295;
    /// The text of the script the diagnostic is about, e.g. a table parameter
    text_span: dashql.buffers.parser.TextSpan;
    /// Does the diagnostic invalidate the plan?
    error: bool;
}

table ExecutionGraph {
    scripts: [ExecutionGraphScript];
    entities: [ExecutionGraphEntity];
    unresolved_references: [ExecutionGraphUnresolvedReference];
    nodes: [ExecutionGraphNode];
    edges: [ExecutionGraphEdge];
    diagnostics: [ExecutionGraphDiagnostic];
    valid: bool = true;
    connections: [ExecutionGraphConnection];
    materializations: [ExecutionGraphMaterialization];
    references: [ExecutionGraphScriptReference];
    /// The attachments of the request, in its order
    attachments: [ExecutionGraphAttachment];
}

/// What a script reference reads, the check of the script references of a session. An ATTACHMENT reference scans an
/// attachment of the session.
enum ScriptReferenceKind: uint8 { INLINE, SCAN, INVALID, ATTACHMENT }

/// A table parameter of a script that references a script or an attachment
table CheckedScriptReference {
    /// The parameter, with the prefix, in the offset unit of the script session
    text_span: dashql.buffers.parser.TextSpan;
    /// The parameter name, empty for a positional parameter
    parameter: string;
    /// The referenced script, absent if the name finds none
    script: uint32 = 4294967295;
    kind: ScriptReferenceKind;
    /// The errors of the reference, the messages of the planner
    errors: [string];
    /// The referenced attachment
    attachment: uint32 = 4294967295;
}

/// Scripts and attachments whose names are equal in case, a table parameter with the name is ambiguous
table TableParameterCollision {
    /// The name of the first of them
    name: string;
    /// The scripts with the name
    scripts: [uint32];
    /// The attachments with the name
    attachments: [uint32];
}

/// The checked script references of a script
table CheckedScript {
    /// Was the script checked? A script whose analysis is not current with its text is not.
    checked: bool;
    /// The text version of the analysis that was checked
    text_version: uint64;
    /// The table parameters of the script in text order
    references: [CheckedScriptReference];
}

/// The checked script references of the scripts of a session, in session order
table ScriptReferenceCheck {
    scripts: [CheckedScript];
    /// The names of table parameters that collide
    collisions: [TableParameterCollision];
}

/// What carries the data of a dataflow edge
/// An INPUT edge starts at an input, its from_script is the index of the input
/// An ATTACHMENT edge starts at an attachment, its from_script is the index of the attachment
enum DataflowEdgeKind: uint8 { INLINE_REFERENCE, SCAN_REFERENCE, INVALID_REFERENCE, TABLE, INPUT, ATTACHMENT }

/// An attachment in the dataflow of a session
table DataflowAttachment {
    /// The name of the table parameter, `sales` for `sales.parquet`
    name: string;
    /// The file name
    file: string;
}

/// A statement of a script in the dataflow of a session
table DataflowStatement {
    statement_type: dashql.buffers.parser.StatementType;
    /// The relation that the statement creates, writes or drops
    target: string;
    /// The text of the statement, in the offset unit of the script session
    text_span: dashql.buffers.parser.TextSpan;
}

/// A script in the dataflow of a session
table DataflowScript {
    /// Was the script analyzed? A script whose analysis is not current with its text is not, its statements and
    /// the edges that start or end at it are unknown.
    analyzed: bool;
    /// The text version of the analysis
    text_version: uint64;
    /// The statements in script order
    statements: [DataflowStatement];
    /// Does the script run only on request, its `@manual` tag? Runs of the whole session and of input changes leave
    /// it out.
    manual: bool;
}

/// The flow of data from one statement to another
table DataflowEdge {
    from_script: uint32;
    from_statement: uint32;
    to_script: uint32;
    to_statement: uint32;
    kind: DataflowEdgeKind;
    /// The parameter name of a reference, the relation name of a table edge
    name: string;
}

/// Where the type of an input comes from
enum SessionInputTypeSource: uint8 { CAST, LITERAL, NONE }

/// A statement that uses an input
struct SessionInputConsumer {
    script: uint32;
    statement: uint32;
}

/// An input of a session: a named scalar parameter of its scripts and its value, see docs/design/session_inputs.md
table SessionInput {
    /// The name of the parameter
    name: string;
    /// The type, of a cast or inferred from the value
    sql_type: dashql.buffers.analyzer.SqlType;
    /// Where the type comes from
    type_source: SessionInputTypeSource;
    /// The value of the session, the literal of the first `@param` tag with a value in session order, in the Hyper
    /// dialect, absent if no script has one
    literal: string;
    /// The value as a control shows it: the number, the content of a string, the text of a typed literal
    value: string;
    /// Does the input have a value?
    has_value: bool;
    /// The statements that use the input, in session order
    consumers: [SessionInputConsumer];
    /// The problems of the input
    warnings: [string];
}

/// The inputs of a session, in the order of their first use
table SessionInputs {
    inputs: [SessionInput];
}

/// The dataflow of the scripts of a session, see docs/design/dataflow.md
table SessionDataflow {
    /// The scripts in session order
    scripts: [DataflowScript];
    /// The inputs in the order of their first use, the sources of the INPUT edges
    inputs: [SessionInput];
    /// The edges, sorted and without duplicates
    edges: [DataflowEdge];
    /// The attachments of the session, the sources of the ATTACHMENT edges
    attachments: [DataflowAttachment];
}
