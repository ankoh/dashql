include "dashql/status.fbs";
include "dashql/parsed_script.fbs";
include "dashql/script_cursor.fbs";

namespace dashql.buffers.editor;

/// The coordinate space selected when an editor session is created.
enum EditorOffsetUnit: uint8 {
    UTF8_BYTES,
    UTF16_CODE_UNITS,
}

enum EditorEventOrigin: uint8 {
    UNSPECIFIED = 0,
    USER = 1,
    SYSTEM = 2,
    REMOTE = 4,
}

enum EditorEventIntent: uint8 {
    UNSPECIFIED,
    EDIT,
    SELECTION,
    REPLACE,
    ANALYZE,
}

enum EditorEventAction: uint8 {
    UNSPECIFIED,
    TYPE,
    DELETE,
    PASTE,
    UNDO,
    REDO,
    FORMAT,
    APPLY,
}

enum EditorUpdateStatus: uint8 {
    OK,
    STALE_TEXT_VERSION,
    INVALID_UTF8,
    INVALID_RANGE,
    OVERLAPPING_CHANGES,
    INVALID_EVENT,
    ANALYSIS_FAILED,
}

/// A replacement range in the document before any changes in the event are applied.
table EditorTextChange {
    from: uint64;
    to: uint64;
    insert: string;
}

/// The primary selection. A cursor is represented by equal anchor and head offsets.
table EditorSelection {
    anchor: uint64;
    head: uint64;
}

/// A half-open range in the editor session's selected offset unit.
struct EditorTextSpan {
    offset: uint64;
    length: uint64;
}

enum EditorDiagnosticSource: uint8 {
    SCANNER,
    PARSER,
    ANALYZER,
}

enum EditorDiagnosticSeverity: uint8 {
    ERROR,
    WARNING,
}

table EditorDiagnostic {
    source: EditorDiagnosticSource;
    severity: EditorDiagnosticSeverity;
    message: string;
    text_span: EditorTextSpan;
}

/// A scanner token class and its source span. Comments are emitted as COMMENT spans.
/// A struct, an update carries one per token.
struct EditorSyntaxSpan {
    text_span: EditorTextSpan;
    token_type: dashql.buffers.parser.ScannerTokenType;
    /// The span lies in a comment: a comment span, or a token of a `@vis` tag
    in_comment: bool;
}

enum EditorSemanticReferenceKind: uint8 {
    TABLE,
    COLUMN,
    FUNCTION,
}

enum EditorSemanticResolution: uint8 {
    UNRESOLVED,
    RESOLVED,
}

/// A table or column reference projected from the analyzer.
/// A struct, an update carries one per reference. The fields are ordered by size to avoid padding.
struct EditorSemanticSpan {
    text_span: EditorTextSpan;
    catalog_table_id: uint64;
    reference_id: uint32;
    catalog_database_id: uint32;
    catalog_schema_id: uint32;
    catalog_column_id: uint32;
    referenced_catalog_version: uint32;
    kind: EditorSemanticReferenceKind;
    resolution: EditorSemanticResolution;
}

enum EditorCursorSemanticKind: uint8 {
    NONE,
    TABLE_REFERENCE,
    COLUMN_REFERENCE,
}

/// Semantic context for the collapsed primary cursor and refs related to its resolved target.
table EditorCursorSemanticContext {
    kind: EditorCursorSemanticKind;
    reference_id: uint32;
    resolved: bool;
    catalog_database_id: uint32;
    catalog_schema_id: uint32;
    catalog_table_id: uint64;
    catalog_column_id: uint32;
    referenced_catalog_version: uint32;
    related_table_reference_ids: [uint32];
    related_column_reference_ids: [uint32];
    /// The catalog entry that declares the resolved table, the script of a session or the script a
    /// catalog descriptor was built from
    declaration_catalog_entry_id: uint32;
    /// The UTF-8 byte span of the declaration in the text of that script: the column definition
    /// of a resolved column, else the table name. Absent if the declaration has no location.
    declaration_location: dashql.buffers.parser.TextSpan;
}

/// Portable cursor facts used by editor interaction logic.
table EditorCursorState {
    text_offset: uint64;
    scanner_relative_position: dashql.buffers.cursor.RelativeSymbolPosition;
    scanner_symbol_completable: bool;
}

table EditorTableDefinition {
    name: string;
    statement_id: uint32;
}

/// A `@<tag>` region of the comments, e.g. `-- @description` up to `-- @end`
table EditorCommentTag {
    /// The tag name without the `@`, e.g. `description`
    name: string;
    /// The whole region, with the comment markers, the tag line and the closing `@end`
    text_span: EditorTextSpan;
    /// The content lines without the comment markers and the tag
    lines: [EditorTextSpan];
}

table EditorStatementDescription {
    statement_id: uint32;
    statement_type: dashql.buffers.parser.StatementType;
    text_span: EditorTextSpan;
}

table EditorStatement {
    statement_id: uint32;
    statement_type: dashql.buffers.parser.StatementType;
    text_span: EditorTextSpan;
}

table EditorScriptAnnotations {
    table_definitions: [EditorTableDefinition];
    has_visualization_compilation: bool;
    statement_descriptions: [EditorStatementDescription];
    referenced_table_names: [string];
    statements: [EditorStatement];
}

/// Plain processing values copied from ScriptStatistics.
table EditorProcessingStatistics {
    scanner_last_elapsed_ns: double;
    parser_last_elapsed_ns: double;
    analyzer_last_elapsed_ns: double;
    rope_bytes: uint64;
    scanner_input_bytes: uint64;
    scanner_symbol_bytes: uint64;
    scanner_name_dictionary_bytes: uint64;
    parser_ast_bytes: uint64;
    analyzer_description_bytes: uint64;
    analyzer_name_index_size: uint64;
    analyzer_name_index_bytes: uint64;
}

/// Identifies an analysis: the text version and the catalog revision it was analyzed at.
table EditorAnalysisVersion {
    text_version: uint64;
    catalog_revision: uint64;
}

/// One portable editor transaction. Changes use pre-change offsets; the selection uses post-change offsets.
table EditorEvent {
    expected_text_version: uint64;
    changes: [EditorTextChange];
    primary_selection: EditorSelection;
    origin: EditorEventOrigin;
    intent: EditorEventIntent;
    action: EditorEventAction;
    analyze: bool;
    /// The version of the analysis the host holds. If the analysis after the event has this version, the update
    /// leaves the analysis out and sets analysis_omitted.
    known_analysis: EditorAnalysisVersion;
}

/// The state observed after applying an EditorEvent or another ScriptSession operation.
table EditorUpdate {
    status: EditorUpdateStatus;
    status_message: string;
    core_status: dashql.buffers.status.StatusCode = OK;
    offset_unit: EditorOffsetUnit = UTF8_BYTES;
    catalog_entry_id: uint32;
    text_version: uint64;
    state_revision: uint64;
    catalog_revision: uint64;
    text_changed: bool;
    selection_changed: bool;
    analysis_updated: bool;
    analysis_available: bool;
    primary_selection: EditorSelection;
    origin: EditorEventOrigin;
    intent: EditorEventIntent;
    action: EditorEventAction;
    /// Full portable projection of the current analysis. Empty when analysis_available is false, and left out when
    /// analysis_omitted is set.
    diagnostics: [EditorDiagnostic];
    syntax_spans: [EditorSyntaxSpan];
    semantic_spans: [EditorSemanticSpan];
    primary_cursor_context: EditorCursorSemanticContext;
    script_annotations: EditorScriptAnnotations;
    processing_statistics: EditorProcessingStatistics;
    primary_cursor_state: EditorCursorState;
    /// The analysis is the known analysis of the event: diagnostics, syntax and semantic spans, script annotations
    /// and processing statistics are left out, the host keeps the ones it holds. The cursor state and context are
    /// always included.
    analysis_omitted: bool;
    /// The JSON objects of the `@vis vegalite` tags in the comments, from the opening to the closing brace. Part of
    /// the analysis, left out with it.
    vegalite_specs: [EditorTextSpan];
    /// The `@<tag>` regions of the comments in script order. Part of the analysis, left out with it.
    comment_tags: [EditorCommentTag];
}
