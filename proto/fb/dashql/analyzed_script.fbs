include "dashql/parsed_script.fbs";
include "dashql/parsed_script_enums.fbs";
include "dashql/algebra_expressions.fbs";
include "dashql/markdown.fbs";
include "dashql/visualization.fbs";

namespace dashql.buffers.analyzer;

enum SemanticNodeMarkerType: uint8 {
    NONE = 0,
    COLUMN_REFERENCE = 1,
    LITERAL_NULL = 5,
    LITERAL_INTEGER = 6,
    LITERAL_FLOAT = 7,
    LITERAL_STRING = 8,
    LITERAL_INTERVAL = 9,
    CONSTANT_EXPRESSION = 10,
    CONSTANT_EXPRESSION_ROOT = 11,
    TABLE_REFERENCE = 15,
    RESULT_TARGET = 16,
}

table DatabaseDeclaration {
    // The unified database id across all catalog entries
    catalog_database_id: uint32;
    // The column name
    database_name: string;
}

table SchemaDeclaration {
    // The unified database id across all catalog entries
    catalog_database_id: uint32;
    // The unified schema id across all catalog entries
    catalog_schema_id: uint32;
    // The schema name
    schema_name: string;
}

table QualifiedTableName {
    // The node id
    ast_node_id: uint32;
    // The name of the database that owns the table (if any)
    database_name: string;
    // The name of the schema that holds the table (if any)
    schema_name: string;
    // The table name, always a table for now
    table_name: string;
}

table QualifiedColumnName {
    // The node id
    ast_node_id: uint32;
    // The table alias, if exists
    table_alias: string;
    // The column name
    column_name: string;
}

table QualifiedFunctionName {
    // The node id
    ast_node_id: uint32;
    // The name of the database that owns the table (if any)
    database_name: string;
    // The name of the schema that holds the table (if any)
    schema_name: string;
    // The function name
    function_name: string;
}

table TableColumn {
    // The id of the AST node that created this column declaration
    ast_node_id: uint32;
    // The name of the column that is referenced
    column_name: string;
    // The UTF-8 byte span of the column definition in the declaring script, absent if derived
    location: dashql.buffers.parser.TextSpan;
    // The text of the declared type, absent if a column has no declaration or nothing tells the type
    column_type: string;
}

table Table {
    // The id of the table in the catalog
    catalog_table_id: uint64;
    // The unified database id across all catalog entries
    catalog_database_id: uint32;
    // The unified schema id across all catalog entries
    catalog_schema_id: uint32;
    // The id of the AST node that created this table declaration.
    ast_node_id: uint32 ;
    // The id of the statement that created the table declaration
    ast_statement_id: uint32;
    // The root of the scope where this table reference is live
    ast_scope_root: uint32;
    // The name of the table that is declared by the node
    table_name: QualifiedTableName;
    // The table columns
    table_columns: [TableColumn];
    // The UTF-8 byte span of the table name in the declaring script
    location: dashql.buffers.parser.TextSpan;
}

table ResolvedTable {
    // The resolved unified database id across all catalog entries
    catalog_database_id: uint32;
    // The resolved unified schema id across all catalog entries
    catalog_schema_id: uint32;
    // The id of the table that is referenced.
    // <uint32, uint32> that may point into the catalog.
    // Referencing a local table only if the upper u32 equals the scripts external id.
    catalog_table_id: uint64;
    /// The referenced catalog version
    referenced_catalog_version: uint32;
    /// The name of the table that is referenced
    table_name: QualifiedTableName;
}

enum TableReferenceRole: uint8 {
    READ = 0,
    WRITE = 1,
}

table TableReference {
    // The id of the AST node that created this table reference
    ast_node_id: uint32;
    // The id of the statement that contains the table reference
    ast_statement_id: uint32;
    // The root of the scope where this table reference is live
    ast_scope_root: uint32;
    // The location
    symbol_span: parser.SymbolSpan;
    // The name of the table that is referenced
    table_name: QualifiedTableName;
    // The alias name
    alias_name: string;
    /// The resolved relation
    resolved_table: ResolvedTable;
    /// Whether the relation is read from or written to
    role: TableReferenceRole = READ;
}

table InsertTargetColumn {
    /// The target-column NAME node
    ast_node_id: uint32;
    /// The written column name
    column_name: string;
    /// The resolved target column, if available
    resolved_column: algebra.ResolvedColumn;
}

table InsertStatement {
    /// The INSERT root node
    ast_node_id: uint32;
    /// The statement containing the INSERT
    ast_statement_id: uint32;
    /// Index into AnalyzedScript.table_references
    target_table_reference_id: uint32;
    /// Source SELECT node, or UINT32_MAX for DEFAULT VALUES
    source_ast_node_id: uint32;
    /// Whether this is INSERT ... DEFAULT VALUES
    default_values: bool;
    /// Whether the statement has a RETURNING projection
    returning: bool;
    /// Explicit target columns, in source order
    target_columns: [InsertTargetColumn];
}

table FunctionParam {
    // The id of the AST node
    ast_node_id: uint32;
    // The parameter name
    param_name: string;
    // The parameter type name
    param_type: string;
}

table FunctionDeclaration {
    // The id of the AST node that created this function declaration
    ast_node_id: uint32;
    // The id of the statement that created the function declaration
    ast_statement_id: uint32;
    // Is this an aggregate function?
    is_aggregate: bool = false;
    // The name of the function
    function_name: QualifiedFunctionName;
    // The function parameters
    params: [FunctionParam];
    // The return type name
    return_type: string;
    // The UTF-8 byte span of the function name in the declaring script
    location: dashql.buffers.parser.TextSpan;
}

table FunctionReference {
    // The id of the AST node that created this table declaration.
    ast_node_id: uint32 ;
    // The id of the statement that created the table declaration
    ast_statement_id: uint32;
    // The root of the scope where this table reference is live
    ast_scope_root: uint32;
    // The name of the function that is declared by the node
    function_name: QualifiedFunctionName;
}

/// What a parameter stands for
enum ParameterKind: uint8 {
    /// A scalar value, e.g. `where x > :min`
    SCALAR = 0,
    /// A table, e.g. `from :source`
    TABLE = 1,
}

/// The kind of a SQL type
enum SqlTypeKind: uint8 {
    BOOL,
    INT1,
    INT2,
    INT4,
    INT8,
    FLOAT4,
    FLOAT8,
    NUMERIC,
    VARCHAR,
    CHAR,
    TEXT,
    BIT,
    DATE,
    TIME,
    TIMESTAMP,
    INTERVAL,
    GENERIC,
}

/// A structured SQL type, e.g. the type of a cast
table SqlType {
    /// The kind of the element type
    kind: SqlTypeKind = BOOL;
    /// The number of array dimensions, 0 for a scalar type
    array_dimensions: uint8 = 0;
    /// The precision of NUMERIC, TIME, TIMESTAMP and INTERVAL, -1 if unset
    precision: int32 = -1;
    /// The scale of NUMERIC, -1 if unset
    scale: int32 = -1;
    /// The length of VARCHAR, CHAR and BIT, -1 if unset
    length: int32 = -1;
    /// Does a TIME or TIMESTAMP have a time zone?
    with_time_zone: bool = false;
    /// Is a BIT varying?
    varying: bool = false;
    /// The fields of an INTERVAL (a parser.IntervalType), -1 if unset
    interval_fields: int16 = -1;
    /// The name of a GENERIC type, lowercased
    name: string;
    /// The modifiers of a GENERIC type as written
    modifiers: [string];
    /// The SQL text of the type, e.g. `numeric(10,2)`
    sql: string;
}

/// A parameter of the script: a named `:name` (also `:"name"`, `:'name'`), a positional `$1` or an unnamed `?`
table Parameter {
    // The id of the parameter ref node
    ast_node_id: uint32;
    // The id of the statement that contains the parameter
    ast_statement_id: uint32;
    // The location, with the prefix
    symbol_span: parser.SymbolSpan;
    /// What the parameter stands for
    kind: ParameterKind = SCALAR;
    /// The name without the prefix, "1" for `$1`, null for an unnamed `?`
    name: string;
    /// The type of the cast whose value is a scalar parameter, `:min::int`
    cast_type: SqlType;
}

struct ConstantExpression {
    // The id of the AST node that created this constant expression
    ast_node_id: uint32;
    // The id of the statement that contains this constant expression
    ast_statement_id: uint32;
    // The location
    symbol_span: parser.SymbolSpan;
    /// The filter expression
    expression_id: uint32;
}

struct IndexedTableReference {
    /// The catalog database id
    catalog_database_id: uint32;
    /// The catalog schema id
    catalog_schema_id: uint32;
    /// The catalog table id
    catalog_table_id: uint64;
    /// The table reference id
    table_reference_id: uint32;
}

struct IndexedColumnReference {
    /// The catalog database id
    catalog_database_id: uint32;
    /// The catalog schema id
    catalog_schema_id: uint32;
    /// The catalog table id
    catalog_table_id: uint64;
    /// The column id
    table_column_id: uint32;
    /// The expression id
    expression_id: uint32;
}

table NameScope {
    /// The scope id
    scope_id: uint32;
    /// The ast node id
    ast_node_id: uint32;
    /// The ast statement id
    ast_statement_id: uint32;
    /// The child scopes
    child_scopes: [uint32];
    /// The column references in this scope
    expressions: [uint32];
    /// The table references in this scope
    table_references: [uint32];
}

enum NameTag: uint8 {
    NONE = 0,
    SCHEMA_NAME = 1,
    DATABASE_NAME = 2,
    TABLE_NAME = 4,
    TABLE_ALIAS = 8,
    COLUMN_NAME = 16,
    FUNCTION_NAME = 32,
}

enum AnalyzerErrorType: uint8 {
    COLUMN_REF_AMBIGUOUS,
    DUPLICATE_TABLE_ALIAS,
    UNSUPPORTED_VIS_KEY,
    INVALID_DASHBOARD_LAYOUT,
    MALFORMED_COMMENT_TAG,
    INVALID_VIS_TAG,
    INVALID_PARAM_TAG,
    CLIENT_FUNCTION_UNKNOWN_FUNCTION,
    CLIENT_FUNCTION_UNKNOWN_OPTION,
    CLIENT_FUNCTION_MISSING_OPTION,
    CLIENT_FUNCTION_DUPLICATE_OPTION,
    CLIENT_FUNCTION_UNSUPPORTED_OPTION,
    CLIENT_FUNCTION_INVALID_VALUE,
}

/// The severity of an analyzer error. WARNING-level diagnostics still carry a
/// text span (so they underline in the editor) without making the script fail.
enum AnalyzerErrorSeverity: uint8 {
    ERROR = 0,
    WARNING = 1,
}

table AnalyzerError {
    /// The error type
    error_type: AnalyzerErrorType;
    /// The severity (defaults to ERROR for existing diagnostics)
    severity: AnalyzerErrorSeverity = ERROR;
    /// The ast node id
    ast_node_id: uint32;
    /// The symbol location
    symbol_span: parser.SymbolSpan;
    /// The text location
    text_span: parser.TextSpan;
    /// The error message
    message: string;
}

table AnalyzerWarning {}

/// A visualization specification produced by the analyzer from the `@vis` tags of a query.
table VisualizationSpec {
    /// The AST node id of the visualized query
    ast_node_id: uint32;
    /// The id of the statement containing this visualization
    ast_statement_id: uint32;
    /// The visualization renderer named by the `@vis` tag (`vegalite`, `markdown` or `table`)
    renderer: string;
    /// The pretty-printed Vega-Lite JSON specification with the query as `data`.
    /// Only populated when `renderer` is `vegalite`.
    vegalite_spec: string;
    /// The compiled Markdown row-template AST. Only populated when `renderer`
    /// is `markdown`.
    markdown_spec: visualization.MarkdownSpec;
    /// Normalized dashboard grid placement shared by every renderer.
    dashboard: visualization.DashboardSpec;
    /// The table renderer spec. Only populated when `renderer` is `table`.
    table_spec: visualization.TableSpec;
}

/// The confidence of a schema-inference result
enum InferenceConfidence: uint8 {
    /// No inference
    NONE = 0,
    /// Owner is one of several feasible unresolved tables (ambiguous, best-guess only)
    CANDIDATE = 1,
    /// Owner is forced (alias-qualified, or uniquely determined by constraint propagation)
    CONFIDENT = 2,
}

/// An inferred column of a table that is not present in the catalog
table InferredColumn {
    /// The column name
    column_name: string;
    /// The confidence of the inference
    confidence: InferenceConfidence = NONE;
    /// For CANDIDATE columns: the other feasible owner tables the solver could not rule out.
    /// Empty when CONFIDENT.
    candidate_table_names: [QualifiedTableName];
}

/// An inferred schema for a table that is not present in the catalog, derived from how its
/// columns are used (e.g. `f.x`, `f.y` against an unresolved `foo f`).
table InferredTableSchema {
    /// The table name
    table_name: QualifiedTableName;
    /// The confidence of the schema (max over its columns)
    confidence: InferenceConfidence = NONE;
    /// The inferred columns
    columns: [InferredColumn];
}

/// Does a client function change anything?
enum ClientFunctionEffect: uint8 {
    READ = 0,
    WRITE = 1,
}

/// A call in a namespace with client functions, it never reaches the backend
table ClientFunctionCall {
    // The id of the call node, the root of the statement or the body of its EXPLAIN
    ast_node_id: uint32;
    // The id of the statement
    ast_statement_id: uint32;
    // Prints the request, sends nothing?
    explain: bool = false;
    // The namespace of the spec
    namespace_name: string;
    // The function, null if the spec does not know it
    function_name: string;
    // The effect of the function, a write if it is unknown
    effect: ClientFunctionEffect = WRITE;
    // The call as JSON for the runtime, null if the spec does not know the function
    description: string;
}

table AnalyzedScript {
    /// The external id that the user specified for this catalog entry
    catalog_entry_id: uint32;

    /// The errors
    errors: [AnalyzerError];
    /// The warnings
    warnings: [AnalyzerWarning];

    /// The node markers for every ast node.
    ///
    /// Script markers annotate ast nodes with lightweight semantic tags.
    /// We, for example, remember which ast nodes store a column ref, literals or constant expressions.
    /// These markers can be used in the UI for hints and highlighting.
    node_markers: [SemanticNodeMarkerType];

    /// The tables
    tables: [Table];
    /// The table references
    table_references: [TableReference];
    /// The indexed table references, sorted by (database_id, schema_id, table_id).
    /// This allows resolving table references in logarithmic time using catalog ids.
    /// Does not contain entries for unresolved table refs.
    resolved_table_references_by_id: [IndexedTableReference];

    /// A subset of expressions relevant for the analyzer output
    expressions: [algebra.Expression];
    /// The indexed column references, sorted by (database_id, schema_id, table_id, column_id)
    /// This allows resolving column references in logarithmic time using catalog ids.
    /// Does not contain entries for unresolved column refs.
    resolved_column_references_by_id: [IndexedColumnReference];
    /// The constant expressions.
    /// We track constant expressions in the AST and emit an entry for the expression root.
    constant_expressions: [ConstantExpression];
    /// The name scopes
    name_scopes: [NameScope];
    /// The statement root scopes
    statement_root_scopes: [uint32];

    // The function references
    function_references: [FunctionReference];

    // The function declarations
    function_declarations: [FunctionDeclaration];

    /// The visualization specs produced by analyzing VISUALIZE statements
    visualization_specs: [VisualizationSpec];

    /// The inferred schemas for tables that are referenced but not present in the catalog.
    /// Derived from how columns are used against unresolved tables (schema inference).
    inferred_table_schemas: [InferredTableSchema];

    /// INSERT statements and their resolved write targets
    insert_statements: [InsertStatement];

    /// The parameters, in the order of the script
    parameters: [Parameter];

    /// The calls in a namespace with client functions
    client_function_calls: [ClientFunctionCall];
}
