include "dashql/parsed_script.fbs";

namespace dashql.buffers.profile;

/// The engine that produced a plan
enum ProfileEngine: uint8 {
    UNKNOWN = 0,
    HYPER = 1,
    TRINO = 2,
}

/// The engine-neutral kind of an operator, the renderer picks the operator symbol by kind.
/// The engine type name stays the visible type of the operator.
enum ProfileOperatorKind: uint8 {
    OTHER = 0,
    OUTPUT,
    SCAN,
    EXPLICIT_SCAN,
    VIRTUAL_TABLE,
    TABLE_CONSTRUCTION,
    TABLE_FUNCTION,
    FILTER,
    PROJECT,
    AGGREGATE,
    WINDOW,
    SORT,
    LIMIT,
    JOIN,
    LEFT_OUTER_JOIN,
    RIGHT_OUTER_JOIN,
    FULL_OUTER_JOIN,
    LEFT_SEMI_JOIN,
    RIGHT_SEMI_JOIN,
    LEFT_ANTI_JOIN,
    RIGHT_ANTI_JOIN,
    LEFT_MARK_JOIN,
    RIGHT_MARK_JOIN,
    UNION_ALL,
    UNION,
    INTERSECT_ALL,
    INTERSECT,
    EXCEPT_ALL,
    EXCEPT,
    ITERATION,
    ITERATION_INCREMENT,
    INSERT,
    EXCHANGE,
}

/// The role of an operator in a pipeline
enum ProfileSlotRole: uint8 {
    /// The operator produces the tuples of the pipeline (a scan, the probe of a materialized input)
    SOURCE = 0,
    /// The operator passes tuples on to its parent in the same pipeline
    THROUGH = 1,
    /// The operator consumes the tuples of the pipeline (a hash build, the output)
    SINK = 2,
}

/// The structure of a query plan: operators, edges, fragments, pipelines and their slots, laid out as a tree.
///
/// The structure carries no execution state. Execution state exists only as events (`QueryProfileEvents`), which the
/// renderer folds into its view state. Ids are indexes into the vectors, u32::MAX means none.
/// Strings are indexes into the string dictionary.
table QueryProfile {
    /// The engine that produced the plan
    engine: ProfileEngine;
    /// The structure version, bumped whenever the structure changes (loading a plan, registering entities that
    /// appear at runtime). Events name the version they belong to.
    structure_version: uint32;

    /// The layout config
    layout_config: DerivedProfileLayoutConfig;
    /// The layout info of the entire plan
    layout_rect: ProfileLayoutRect;

    /// The string dictionary allows us to implement most profile types as flat structs.
    /// We do this to simplify the renderer logic.
    string_dictionary: [string];
    /// The attributes of operators, cross edges, fragments and pipelines
    attributes: [ProfileAttribute];

    /// The operators
    operators: [ProfileOperator];
    /// The root operators
    root_operators: [uint32];
    /// The operator edges (child to parent)
    operator_edges: [ProfileOperatorEdge];
    /// The operator cross edges (references that are no containment)
    operator_cross_edges: [ProfileOperatorCrossEdge];

    /// The fragments
    fragments: [ProfileFragment];
    /// The operators owned by a fragment, grouped by fragment
    fragment_operators: [uint32];

    /// The pipelines
    pipelines: [ProfilePipeline];
    /// The slots (an operator in a pipeline), grouped by pipeline
    slots: [ProfileSlot];
    /// The slots of an operator, grouped by operator
    operator_slots: [uint32];
}

struct ProfileLayoutConfig {
    /// The height of a level
    level_height: double;
    /// The height of a node
    node_height: double;
    /// The horizontal margin of a node
    node_margin_horizontal: double;
    /// The left padding of a node
    node_padding_left: double;
    /// The right padding of a node
    node_padding_right: double;
    /// The icon width
    icon_width: double;
    /// The icon width
    icon_margin_right: double;
    /// The maximum label characters
    max_label_chars: uint32;
    /// The number of pixels per label character
    width_per_label_char: double;
    /// The minimum node width
    node_min_width: double;
}

struct DerivedProfileLayoutConfig {
    /// The config
    input: ProfileLayoutConfig;
    /// The computed node width
    computed_node_width: double;
}

struct ProfileLayoutRect {
    /// The x position of the box
    x: double;
    /// The y position of the box
    y: double;
    /// The width of the box
    width: double;
    /// The height of the box
    height: double;
}

struct ProfileAttribute {
    /// The name
    name: uint32;
    /// The value serialized as JSON
    value_json: uint32;
}

struct ProfileOperator {
    /// The operator id of the engine (string), u32::MAX if the engine has none
    engine_id: uint32;
    /// The engine-neutral operator kind
    kind: ProfileOperatorKind;
    /// The operator type name of the engine (string)
    type_name: uint32;
    /// The operator label (string, if any)
    label: uint32;
    /// The parent operator
    parent: uint32;
    /// The path from the parent operator to this operator in the engine plan (string)
    parent_path: uint32;
    /// The source location (if any)
    source_location: parser.SymbolSpan;

    /// The begin of the child operators
    children_begin: uint32;
    /// The number of child operators
    children_count: uint32;
    /// The begin of the outgoing cross edges
    cross_edges_begin: uint32;
    /// The number of outgoing cross edges
    cross_edge_count: uint32;
    /// The begin of the attributes
    attributes_begin: uint32;
    /// The number of attributes
    attribute_count: uint32;
    /// The begin of the slots in `operator_slots`
    slots_begin: uint32;
    /// The number of slots
    slot_count: uint32;
    /// The innermost fragment that contains the operator
    fragment: uint32;

    /// The estimated output rows, NaN if the plan has no estimate
    estimated_rows: double;
    /// The layout info
    layout_rect: ProfileLayoutRect;
}

struct ProfileOperatorEdge {
    /// The child operator
    child: uint32;
    /// The parent operator
    parent: uint32;
    /// The index of the port in the parent
    port_index: uint32;
    /// The number of ports of the parent
    port_count: uint32;
    /// The slot of the child in the pipeline that carries the edge, its output is the flow over the edge
    slot: uint32;
}

struct ProfileOperatorCrossEdge {
    /// The referenced operator
    source: uint32;
    /// The operator containing the reference
    target: uint32;
    /// The begin of the attributes, the first is the relationship `kind`
    attributes_begin: uint32;
    /// The number of attributes
    attribute_count: uint32;
}

struct ProfileFragment {
    /// The fragment id of the engine (string), u32::MAX if the engine has none
    engine_id: uint32;
    /// The enclosing fragment
    parent_fragment: uint32;
    /// The root operator, u32::MAX if the fragment has no operators (yet)
    root_operator: uint32;
    /// The begin of the operators owned by the fragment in `fragment_operators`.
    /// Operators of nested fragments belong to the nested fragment only, the contour encloses both.
    operators_begin: uint32;
    /// The number of operators owned by the fragment
    operator_count: uint32;
    /// The begin of the attributes
    attributes_begin: uint32;
    /// The number of attributes
    attribute_count: uint32;
    /// 1 if the renderer draws no contour for the fragment (0/1, esbuild fails on generated TS booleans)
    hidden: uint8;
}

struct ProfilePipeline {
    /// The pipeline id of the engine (string), u32::MAX if the engine has none
    engine_id: uint32;
    /// The fragment that runs the pipeline
    fragment: uint32;
    /// The begin of the slots
    slots_begin: uint32;
    /// The number of slots
    slot_count: uint32;
    /// The begin of the attributes
    attributes_begin: uint32;
    /// The number of attributes
    attribute_count: uint32;
}

struct ProfileSlot {
    /// The pipeline
    pipeline: uint32;
    /// The operator
    operator: uint32;
    /// The role of the operator in the pipeline
    role: ProfileSlotRole;
}
