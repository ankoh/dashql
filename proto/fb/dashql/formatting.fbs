
namespace dashql.buffers.formatting;

enum FormattingDialect: uint8 {
    HYPER = 0,
    TRINO = 2,
}

enum FormattingMode: uint8 {
    INLINE = 0,
    COMPACT = 1,
    PRETTY = 2,
}

enum KeywordCase: uint8 {
    LOWER = 0,
    UPPER = 1,
}

table FormattingConfig {
    /// The formatting dialect
    dialect: FormattingDialect;
    /// The formatting mode
    mode: FormattingMode;
    /// The maximum width that we want to render
    max_width: uint32;
    /// The indentation width
    indentation_width: uint32;
    /// Emit debug comments before each inserted line break.
    debug_mode: bool;
    /// Case of generated SQL keywords (not names or source literals).
    keyword_case: KeywordCase;
}
