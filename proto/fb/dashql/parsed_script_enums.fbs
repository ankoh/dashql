namespace dashql.buffers.parser;

enum ExpressionOperator: uint8 {
    DEFAULT,

    NEGATE,
    NOT,
    TYPECAST,
    COLLATE,
    AT_TIMEZONE,

    PLUS,
    MINUS,
    MULTIPLY,
    DIVIDE,
    MODULUS,
    AND,
    OR,
    XOR,
    GLOB,
    NOT_GLOB,

    IS_NULL,
    LIKE,
    ILIKE,
    SIMILAR_TO,
    NOT_NULL,
    NOT_LIKE,
    NOT_ILIKE,
    NOT_SIMILAR_TO,

    IS_TRUE,
    IS_FALSE,
    IS_UNKNOWN,
    IS_DISTINCT_FROM,
    IS_OF,
    IS_NOT_TRUE,
    IS_NOT_FALSE,
    IS_NOT_UNKNOWN,
    IS_NOT_DISTINCT_FROM,
    IS_NOT_OF,

    EQUAL,
    NOT_EQUAL,
    GREATER_EQUAL,
    GREATER_THAN,
    LESS_EQUAL,
    LESS_THAN,

    BETWEEN_SYMMETRIC,
    BETWEEN_ASYMMETRIC,
    NOT_BETWEEN_SYMMETRIC,
    NOT_BETWEEN_ASYMMETRIC,
    IN,
    NOT_IN,

    OVERLAPS
}

