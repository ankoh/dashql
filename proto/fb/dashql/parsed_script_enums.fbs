enum JoinType: uint8 {
    NONE = 0,

    INNER = 1,
    FULL = 2,
    LEFT = 3,
    RIGHT = 4,
    SEMI = 5,
    ANTI = 6,

    // v | 64
    OUTER_ = 64,
    OUTER_INNER_INVALID = 65,
    OUTER_FULL = 66,
    OUTER_LEFT = 67,
    OUTER_RIGHT = 68,

    // v | 128
    NATURAL_ = 128,
    NATURAL_INNER = 129,
    NATURAL_FULL = 130,
    NATURAL_LEFT = 131,
    NATURAL_RIGHT = 132,

    // v | 128 | 64
    NATURAL_OUTER_ = 192,
