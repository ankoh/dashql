{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashql/app_event.json",
  "title": "AppEventData",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "session": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Session ZIP (contains connection params, session scripts, etc.)"
        }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    {
      "properties": {
        "hyperLink": {
          "type": "object",
          "description": "Point new sessions at a Hyper that speaks the HTTP v3 API, e.g. the hyperd of hyperd run --ui",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "The base url of the HTTP v3 API, http only on this machine"
            },
            "token": {
              "type": "string",
              "description": "The bearer token of the Hyper, it is never stored durably"
            }
          },
          "required": ["endpoint", "token"],
          "additionalProperties": false
        }
      },
      "required": ["hyperLink"],
      "additionalProperties": false
    },
    {
      "properties": {
        "oauthRedirect": {
          "$ref": "auth.json#/definitions/OAuthRedirectData",
          "description": "Provide the oauth redirect"
        }
      },
      "required": ["oauthRedirect"],
      "additionalProperties": false
    }
  ]
}
