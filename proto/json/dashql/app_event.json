{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashql/app_event.json",
  "title": "AppEventData",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "session": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "The .dashql ZIP of a workbook in links of older versions, current links carry it in the zip parameter"
        }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    {
      "properties": {
        "hyperLink": {
          "type": "object",
          "description": "Point new workbooks at a Hyper that speaks the HTTP v3 API, e.g. the hyperd of hyperd run --ui",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "The base url of the HTTP v3 API, http only on this machine"
            },
            "token": {
              "type": "string",
              "description": "The bearer token of the Hyper, it is never stored durably"
            }
          },
          "required": ["endpoint", "token"],
          "additionalProperties": false
        }
      },
      "required": ["hyperLink"],
      "additionalProperties": false
    },
    {
      "properties": {
        "agentSession": {
          "type": "object",
          "description": "Follow the session of an agent harness, the server of dashql session serve on this machine",
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "The base url of the server, http on a loopback address"
            },
            "token": {
              "type": "string",
              "description": "The token of the server, it is never stored durably"
            }
          },
          "required": ["endpoint", "token"],
          "additionalProperties": false
        }
      },
      "required": ["agentSession"],
      "additionalProperties": false
    },
    {
      "properties": {
        "oauthRedirect": {
          "$ref": "auth.json#/definitions/OAuthRedirectData",
          "description": "Provide the oauth redirect"
        }
      },
      "required": ["oauthRedirect"],
      "additionalProperties": false
    }
  ]
}
