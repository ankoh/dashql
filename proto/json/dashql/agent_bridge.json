{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashql/agent_bridge.json",
  "description": "The messages of the agent bridge: between the agent server and its clients on the WebSocket, and between the server and the command line tool over HTTP. AgentServerMethods and AgentClientMethods name the params and results of the methods on the WebSocket.",
  "definitions": {
    "AgentServerMethods": {
      "type": "object",
      "description": "The requests of a client to the server on the WebSocket, with their params and results",
      "properties": {
        "client/sessions": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/ClientSessionsParams" }, "result": { "$ref": "#/definitions/AgentEmptyMessage" } },
          "required": ["params", "result"],
          "additionalProperties": false
        },
        "agent/request": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentRequestParams" }, "result": { "$ref": "#/definitions/AgentRequestResult" } },
          "required": ["params", "result"],
          "additionalProperties": false
        },
        "agent/cancel": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentCancelParams" }, "result": { "$ref": "#/definitions/AgentEmptyMessage" } },
          "required": ["params", "result"],
          "additionalProperties": false
        },
        "agent/reset": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentSessionParams" }, "result": { "$ref": "#/definitions/AgentEmptyMessage" } },
          "required": ["params", "result"],
          "additionalProperties": false
        },
        "agent/context": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentContextParams" }, "result": { "$ref": "#/definitions/AgentSessionContext" } },
          "required": ["params", "result"],
          "additionalProperties": false
        },
        "agent/info": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentEmptyMessage" }, "result": { "$ref": "#/definitions/AgentServerInfo" } },
          "required": ["params", "result"],
          "additionalProperties": false
        }
      },
      "required": ["client/sessions", "agent/request", "agent/cancel", "agent/reset", "agent/context", "agent/info"],
      "additionalProperties": false
    },
    "AgentClientMethods": {
      "type": "object",
      "description": "The requests and notifications of the server to a client on the WebSocket, with their params and the results of the requests",
      "properties": {
        "command": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentCommandParams" }, "result": { "$ref": "#/definitions/AgentCommandResult" } },
          "required": ["params", "result"],
          "additionalProperties": false
        },
        "agent/status": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentStatusParams" } },
          "required": ["params"],
          "additionalProperties": false
        },
        "agent/done": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentDoneParams" } },
          "required": ["params"],
          "additionalProperties": false
        },
        "agent/failed": {
          "type": "object",
          "properties": { "params": { "$ref": "#/definitions/AgentFailedParams" } },
          "required": ["params"],
          "additionalProperties": false
        }
      },
      "required": ["command", "agent/status", "agent/done", "agent/failed"],
      "additionalProperties": false
    },
    "AgentErrorCode": {
      "type": "string",
      "description": "The error code of a failed call",
      "enum": ["failed", "not_connected", "busy", "usage"]
    },
    "AgentRpcError": {
      "type": "object",
      "description": "The error of a failed call",
      "properties": {
        "code": { "$ref": "#/definitions/AgentErrorCode" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "AgentRpcMessage": {
      "type": "object",
      "description": "A message on the WebSocket. A request {id, method, params} is answered by {id, result} or {id, error}. A message with a method but without an id is a notification.",
      "properties": {
        "id": { "type": ["string", "number"] },
        "method": { "type": "string" },
        "params": { "tsType": "unknown" },
        "result": { "tsType": "unknown" },
        "error": { "$ref": "#/definitions/AgentRpcError" }
      },
      "additionalProperties": false
    },
    "AgentClientSession": {
      "type": "object",
      "description": "A session that a client holds",
      "properties": {
        "id": { "type": "string", "description": "The DashQL session id" },
        "name": { "type": "string", "description": "The display name of the session" }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "ClientSessionsParams": {
      "type": "object",
      "description": "client/sessions, client → server: the sessions with agent access, sent after connecting and on every change. A server with another protocol version closes the WebSocket with 1008.",
      "properties": {
        "protocol": { "const": 2, "description": "The version of the protocol, the server turns away other versions" },
        "client": { "type": "string", "description": "The kind of client, \"web\" or \"desktop\"" },
        "sessions": { "type": "array", "items": { "$ref": "#/definitions/AgentClientSession" } },
        "focused": {
          "type": ["string", "null"],
          "description": "The session that the user looks at, null if it has no agent access"
        }
      },
      "required": ["protocol", "client", "sessions", "focused"],
      "additionalProperties": false
    },
    "AgentCommandParams": {
      "type": "object",
      "description": "command, server → client: run a command of the command line tool against a session",
      "properties": {
        "session": { "type": "string" },
        "command": { "type": "string" },
        "args": { "type": "object", "additionalProperties": { "tsType": "unknown" } }
      },
      "required": ["session", "command", "args"],
      "additionalProperties": false
    },
    "AgentCommandResult": {
      "type": "object",
      "description": "The result of a command",
      "properties": {
        "text": { "type": "string", "description": "The output for the agent" },
        "data": { "tsType": "unknown", "description": "The structured output, printed with --json" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "AgentRequestParams": {
      "type": "object",
      "description": "agent/request, client → server: run the harness with a prompt",
      "properties": {
        "session": { "type": "string" },
        "harness": { "type": "string", "description": "The name of the harness, the server's default if omitted" },
        "model": { "type": "string", "description": "One of the models of the harness, the harness's own default if omitted" },
        "effort": { "type": "string", "description": "One of the efforts of the harness, the harness's own default if omitted" },
        "prompt": { "type": "string" }
      },
      "required": ["session", "prompt"],
      "additionalProperties": false
    },
    "AgentRequestResult": {
      "type": "object",
      "description": "The result of agent/request, the turn that the server queued",
      "properties": {
        "turnId": { "type": "string" },
        "harness": { "type": "string" }
      },
      "required": ["turnId", "harness"],
      "additionalProperties": false
    },
    "AgentCancelParams": {
      "type": "object",
      "description": "agent/cancel, client → server: stop a turn of a session, or all turns of the session without a turn id",
      "properties": {
        "session": { "type": "string" },
        "turnId": { "type": "string" }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "AgentSessionParams": {
      "type": "object",
      "description": "agent/reset, client → server: the session to forget",
      "properties": {
        "session": { "type": "string" }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "AgentContextParams": {
      "type": "object",
      "description": "agent/context, client → server: the session to describe",
      "properties": {
        "session": { "type": "string" },
        "harness": { "type": "string", "description": "The harness of the next request, the server's default if omitted" }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "AgentSessionContext": {
      "type": "object",
      "description": "The result of agent/context",
      "properties": {
        "folder": { "type": "string", "description": "The working folder of harness runs of the session" },
        "harness": { "type": "string", "description": "The harness of the next request" },
        "harnessSession": {
          "type": ["string", "null"],
          "description": "The harness session that the next request resumes"
        },
        "terminalCommand": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "The command that continues the harness session in a terminal"
        }
      },
      "required": ["folder", "harness", "harnessSession", "terminalCommand"],
      "additionalProperties": false
    },
    "AgentEmptyMessage": {
      "type": "object",
      "description": "The params of agent/info, and the result of the methods that return nothing",
      "additionalProperties": false
    },
    "AgentHarnessInfo": {
      "type": "object",
      "description": "A configured harness",
      "properties": {
        "name": { "type": "string" },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The command template, changed in config.json only"
        },
        "adapter": { "type": "string" },
        "program": {
          "type": ["string", "null"],
          "description": "The file that the program resolves to, null if it is not installed"
        },
        "models": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The models that requests may pick, changed in config.json only"
        },
        "efforts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The efforts that requests may pick, changed in config.json only"
        }
      },
      "required": ["name", "command", "adapter", "program", "models", "efforts"],
      "additionalProperties": false
    },
    "AgentServerClient": {
      "type": "object",
      "description": "A client of the agent server",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "origin": { "type": "string" },
        "sessions": { "type": "array", "items": { "$ref": "#/definitions/AgentClientSession" } },
        "focused": { "type": ["string", "null"] }
      },
      "required": ["id", "kind", "origin", "sessions", "focused"],
      "additionalProperties": false
    },
    "AgentTurnState": {
      "type": "string",
      "description": "The state of a turn",
      "enum": ["queued", "running"]
    },
    "AgentTurn": {
      "type": "object",
      "description": "A turn of the agent server: a prompt that a harness works on until it answers",
      "properties": {
        "turnId": { "type": "string" },
        "session": { "type": "string" },
        "harness": { "type": "string" },
        "model": { "type": ["string", "null"], "description": "The model of the request, null for the harness's default" },
        "effort": { "type": ["string", "null"], "description": "The effort of the request, null for the harness's default" },
        "state": { "$ref": "#/definitions/AgentTurnState" },
        "status": { "type": "string", "description": "The latest status line" }
      },
      "required": ["turnId", "session", "harness", "model", "effort", "state", "status"],
      "additionalProperties": false
    },
    "AgentServerStatus": {
      "type": "object",
      "description": "The status of the agent server, for GET /v1/status",
      "properties": {
        "port": { "type": "integer" },
        "clients": { "type": "array", "items": { "$ref": "#/definitions/AgentServerClient" } },
        "turns": { "type": "array", "items": { "$ref": "#/definitions/AgentTurn" } }
      },
      "required": ["port", "clients", "turns"],
      "additionalProperties": false
    },
    "AgentServerInfo": {
      "type": "object",
      "description": "The result of agent/info: the status with the configuration, for the settings of the app",
      "properties": {
        "port": { "type": "integer" },
        "clients": { "type": "array", "items": { "$ref": "#/definitions/AgentServerClient" } },
        "turns": { "type": "array", "items": { "$ref": "#/definitions/AgentTurn" } },
        "home": { "type": "string", "description": "The folder of the configuration and the state" },
        "configPath": { "type": "string" },
        "defaultHarness": { "type": "string", "description": "The harness of requests that name none, from config.json" },
        "harnesses": { "type": "array", "items": { "$ref": "#/definitions/AgentHarnessInfo" } }
      },
      "required": ["port", "clients", "turns", "home", "configPath", "defaultHarness", "harnesses"],
      "additionalProperties": false
    },
    "AgentStatusParams": {
      "type": "object",
      "description": "agent/status, server → client notification: the state of a turn",
      "properties": {
        "session": { "type": "string" },
        "turnId": { "type": "string" },
        "state": { "$ref": "#/definitions/AgentTurnState" },
        "text": { "type": "string", "description": "The latest status line" }
      },
      "required": ["session", "turnId", "state", "text"],
      "additionalProperties": false
    },
    "AgentDoneParams": {
      "type": "object",
      "description": "agent/done, server → client notification: a turn finished",
      "properties": {
        "session": { "type": "string" },
        "turnId": { "type": "string" },
        "message": { "type": "string", "description": "The final message of the agent" }
      },
      "required": ["session", "turnId", "message"],
      "additionalProperties": false
    },
    "AgentFailedParams": {
      "type": "object",
      "description": "agent/failed, server → client notification: a turn failed or was stopped",
      "properties": {
        "session": { "type": "string" },
        "turnId": { "type": "string" },
        "error": { "type": "string" },
        "cancelled": { "type": "boolean" }
      },
      "required": ["session", "turnId", "error", "cancelled"],
      "additionalProperties": false
    },
    "AgentCallRequest": {
      "type": "object",
      "description": "The body of POST /v1/call: a command of the command line tool, for the given or the focused session",
      "properties": {
        "session": { "type": "string" },
        "command": { "type": "string" },
        "args": { "type": "object", "additionalProperties": { "tsType": "unknown" } }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "AgentCallResponse": {
      "description": "The response of POST /v1/call. The failures of every HTTP endpoint have the same shape.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": { "const": true },
            "session": { "type": "string" },
            "result": { "$ref": "#/definitions/AgentCommandResult" }
          },
          "required": ["ok", "session", "result"],
          "additionalProperties": false
        },
        { "$ref": "#/definitions/AgentFailedResponse" }
      ]
    },
    "AgentStatusResponse": {
      "description": "The response of GET /v1/status",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": { "const": true },
            "status": { "$ref": "#/definitions/AgentServerStatus" }
          },
          "required": ["ok", "status"],
          "additionalProperties": false
        },
        { "$ref": "#/definitions/AgentFailedResponse" }
      ]
    },
    "AgentFailedResponse": {
      "type": "object",
      "description": "The response of a failed HTTP call",
      "properties": {
        "ok": { "const": false },
        "error": { "$ref": "#/definitions/AgentRpcError" }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    }
  }
}
